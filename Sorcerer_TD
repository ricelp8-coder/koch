    if not (price and currency) then return end
    local towers = CFG.get("Towers")
    if towers and type(towers.GetTotalStoredTowers) == "function" and type(towers.GetMaxStoredTowers) == "function" then
        local ok1, total = pcall(towers.GetTotalStoredTowers, data)
        local ok2, cap = pcall(towers.GetMaxStoredTowers, data)
        if ok1 and ok2 and cap < total + n then
            LB.stopSummon("unit storage is full")
            return
        end
    end
    local cost = price * n * (n >= 10 and 0.9 or 1)
    if cost > (tonumber(data[currency]) or 0) then
        LB.stopSummon("not enough " .. tostring(currency))
        return
    end
    LB.sumBusy = true
    task.spawn(function()
        pcall(r.InvokeServer, r, sel.name, n)
        LB.sumBusy = false
    end)
end

function LB.claim(key, r, ...)
    local state = LB.claims[key]
    if type(state) == "number" and os.clock() < state then return false end
    if os.clock() < LB.claimNext then return false end
    LB.claims[key] = os.clock() + 25
    LB.claimNext = os.clock() + 0.8
    LB.send(r, ...)
    return true
end
function LB.latestSeason(data, bp)
    local best, bestN
    for key in pairs(bp.Config or {}) do
        local n = tonumber(tostring(key):match("^Season(%d+)$"))
        if n and type(data.Battlepass) == "table" and data.Battlepass[key] and (not bestN or n > bestN) then
            best, bestN = key, n
        end
    end
    return best
end
function LB.claimQuests()
    if LB.questBusy or IN_MATCH then return end
    if not (cfg.autoClaimQuests or cfg.autoClaimDaily or cfg.autoClaimPass) then return end
    LB.questBusy = true
    local ok, err = pcall(function()
        local data = DATA.get()
        if not data then return end
        local R_ = LB.R
        if cfg.autoClaimQuests and R_.ClaimQuest then
            local q = CFG.get("Quests")
            if q and type(q.CheckIfElligible) == "function" then
                for _, kind in ipairs({"Daily", "Weekly"}) do
                    local names = {}
                    for name in pairs(type(q.Config) == "table" and q.Config[kind] or {}) do names[#names + 1] = name end
                    table.sort(names)
                    for _, name in ipairs(names) do
                        if not cfg.autoClaimQuests then return end
                        local okE, elig = pcall(q.CheckIfElligible, data, kind, name)
                        if okE and elig == true and LB.claim("Q/" .. kind .. "/" .. name, R_.ClaimQuest, kind, name) then return end
                    end
                end
            end
        end
        if cfg.autoClaimDaily and R_.ClaimDaily and type(data.DailyRewards) == "table" then
            local d = CFG.get("Daily")
            local dr = data.DailyRewards
            if d and type(d.Config) == "table" and type(dr.Rewards) == "table" then
                local days = {}
                for day in pairs(d.Config) do days[#days + 1] = day end
                table.sort(days)
                for _, day in ipairs(days) do
                    local entry = d.Config[day]
                    local due = (tonumber(dr.LastRefresh) or 0) + (tonumber(entry.Requirement) or 0)
                    if not dr.Rewards[day] and due <= os.time() then
                        if LB.claim("D/" .. tostring(day), R_.ClaimDaily, day) then return end
                    end
                end
            end
        end
        if cfg.autoClaimPass and R_.ClaimPass then
            local bp = CFG.get("Battlepass")
            if bp and type(bp.CheckIfElligible) == "function" and type(bp.Config) == "table" then
                local season = LB.latestSeason(data, bp)
                local sd = season and data.Battlepass[season]
                if season and type(sd) == "table" then
                    for _, kind in ipairs({"Normal", "Premium"}) do
                        local tiers = {}
                        for tier in pairs(bp.Config[season] and bp.Config[season][kind] or {}) do tiers[#tiers + 1] = tier end
                        table.sort(tiers)
                        for _, tier in ipairs(tiers) do
                            if not cfg.autoClaimPass then return end
                            local claimed = type(sd[kind]) == "table" and sd[kind][tier]
                            if not claimed then
                                local okE, elig = pcall(bp.CheckIfElligible, data, season, kind, tier)
                                if okE and elig == true
                                    and LB.claim("B/" .. season .. "/" .. kind .. "/" .. tier, R_.ClaimPass, season, kind, tier) then
                                    return
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
    LB.questBusy = false
    if not ok then warn("[sd] claim: " .. tostring(err)) end
end

function INV.units()
    local data = DATA.get()
    local counts, names = {}, {}
    for _, t in pairs((data and data.Towers) or {}) do
        if type(t) == "table" and type(t.Name) == "string" then
            if not counts[t.Name] then names[#names + 1] = t.Name end
            counts[t.Name] = (counts[t.Name] or 0) + 1
        end
    end
    table.sort(names)
    return names, counts, data ~= nil
end
function INV.display(name)
    local tc = CFG.get("Towers")
    local d = tc and type(tc.Config) == "table" and tc.Config[name]
    return (type(d) == "table" and d.DisplayName) or name
end
function INV.sellPlan(name, mode)
    local data = DATA.get()
    if not (data and type(data.Towers) == "table") then return nil, "Waiting for your inventory" end
    if type(name) ~= "string" or name == "" then return nil, "Select a unit first" end
    if name == "BasicSorcerer" then return nil, "Basic Sorcerer cannot be sold" end
    local ids, total = {}, 0
    for id, t in pairs(data.Towers) do
        if type(t) == "table" and t.Name == name then
            total = total + 1
            local uuid = t.UUID or id
            if t.Equipped ~= true and t.Locked ~= true and type(uuid) == "string" then ids[#ids + 1] = uuid end
        end
    end
    table.sort(ids)
    local want
    if mode == "All" then
        want = #ids
    elseif mode == "One" then
        want = math.min(#ids, 1)
    elseif mode == "KeepOne" then
        want = math.min(#ids, math.max(0, total - 1))
    else
        return nil, "Unknown sell mode"
    end
    while #ids > want do ids[#ids] = nil end
    return ids, nil, total
end
function INV.refreshSell(force)
    local names, counts, have = INV.units()
    local list, byLabel = {"(select a unit)"}, {}
    for _, n in ipairs(names) do
        local label = "(x" .. counts[n] .. ") " .. INV.display(n)
        list[#list + 1] = label
        byLabel[label] = n
    end
    INV.sellLabels = byLabel
    local label
    for l, n in pairs(byLabel) do
        if n == INV.sellName then label = l end
    end
    if INV.sellName and not label and have then INV.sellName = nil end
    local sig = table.concat(list, "\0")
    if INV.w.sellSel and (force or sig ~= INV.sellSig) then
        INV.sellSig = sig
        INV.refreshing = true
        pcall(function()
            INV.w.sellSel:SetOptions(list)
            INV.w.sellSel:Set(label or list[1], true)
        end)
        INV.refreshing = false
    end
    if INV.w.sellInfo then
        local text
        if not have then
            text = "Waiting for your inventory data..."
        elseif INV.sellName then
            local ids, _, total = INV.sellPlan(INV.sellName, "All")
            text = INV.display(INV.sellName) .. ": " .. tostring(total or 0) .. " copies, "
                .. tostring(ids and #ids or 0) .. " sellable (equipped and locked are skipped)"
        else
            text = "Select a unit, then choose an action. Equipped and locked copies are skipped."
        end
        INV.w.sellInfo:SetContent(text)
    end
end
function INV.checkSale()
    local p = INV.sold
    if not p then return end
    local data = DATA.get()
    if not (data and type(data.Towers) == "table") then return end
    for _, id in ipairs(p.ids) do
        if data.Towers[id] ~= nil then
            if os.clock() - p.at > 20 and not p.warned then
                p.warned = true
                flash("Inventory: sale is not confirmed yet", "Warning")
            end
            return
        end
    end
    INV.sold = nil
    flash("Sold " .. #p.ids .. " " .. INV.display(p.name) .. " (confirmed)", "Success")
end
function INV.sell(mode)
    INV.checkSale()
    if INV.sold then
        flash("Inventory: waiting for the previous sale to confirm", "Warning")
        return
    end
    local r = LB.R.SellTowers
    if not r then
        flash("Inventory: SellTowers remote not found (lobby only)", "Error")
        return
    end
    local ids, why = INV.sellPlan(INV.sellName, mode)
    if not ids or #ids == 0 then
        flash(why or "Inventory: no sellable copies for this action", "Warning")
        return
    end
    INV.sold = {ids = ids, name = INV.sellName, at = os.clock()}
    LB.send(r, ids)
    flash("Selling " .. #ids .. " " .. INV.display(INV.sellName), "Info")
end

function INV.setCrate(text)
    if INV.w.crateInfo then INV.w.crateInfo:SetContent(text) end
end
function INV.crates()
    local data = DATA.get()
    local items = CFG.get("Items")
    local byName, order = {}, {}
    if data and type(data.Items) == "table" and items and type(items.Config) == "table" then
        for id, it in pairs(data.Items) do
            local def = type(it) == "table" and items.Config[it.Name]
            if type(def) == "table" and def.Type == "Crate" then
                local e = byName[it.Name]
                if not e then
                    e = {name = it.Name, display = def.DisplayName or it.Name, ids = {}}
                    byName[it.Name] = e
                    order[#order + 1] = e
                end
                e.ids[#e.ids + 1] = it.UUID or id
            end
        end
    end
    table.sort(order, function(a, b) return a.display < b.display end)
    for _, e in ipairs(order) do table.sort(e.ids) end
    return order, byName, data ~= nil
end
function INV.refreshCrates(force)
    local sel = INV.w.crateSel
    if not sel then return end
    local order = INV.crates()
    local list, labels = {}, {}
    for _, e in ipairs(order) do
        local label = e.display .. " (x" .. #e.ids .. ")"
        list[#list + 1] = label
        labels[label] = e.name
    end
    if #list == 0 then list[1] = INV.noCrates end
    INV.crateLabels = labels
    local sig = table.concat(list, "\0")
    if force or sig ~= INV.crateSig then
        INV.crateSig = sig
        local chosen = list[1]
        for label, name in pairs(labels) do
            if name == cfg.openCrateName then chosen = label end
        end
        if labels[chosen] then cfg.openCrateName = labels[chosen] end
        INV.refreshing = true
        pcall(function()
            sel:SetOptions(list)
            sel:Set(chosen, true)
        end)
        INV.refreshing = false
    end
end
function INV.crateStep()
    local now = os.clock()
    local order, byName, have = INV.crates()
    local e = byName[cfg.openCrateName]
    local p = INV.cratePend
    if p then
        local left = e and #e.ids or 0
        if left <= p.count - 1 then
            INV.cratePend = nil
            INV.nextCrate = now + cfg.crateDelay
            INV.setCrate("Opened 1 " .. p.display .. ", " .. left .. " left")
        elseif now - p.at >= 12 then
            INV.cratePend = nil
            INV.nextCrate = now + cfg.crateDelay
            INV.setCrate("Open was not confirmed in 12s, continuing")
        else
            return
        end
    end
    if now < INV.nextCrate then return end
    if not have then
        INV.setCrate("Waiting for your inventory")
        return
    end
    if not e or #e.ids == 0 then
        INV.setCrate("No crates of the selected type")
        return
    end
    local data = DATA.get()
    local towers = CFG.get("Towers")
    if towers and data and type(towers.GetTotalStoredTowers) == "function" and type(towers.GetMaxStoredTowers) == "function" then
        local ok1, total = pcall(towers.GetTotalStoredTowers, data)
        local ok2, cap = pcall(towers.GetMaxStoredTowers, data)
        if ok1 and ok2 and total >= cap then
            INV.setCrate("Unit storage is full: " .. total .. "/" .. cap)
            return
        end
    end
    local r = LB.R.OpenCrate
    if not r then
        INV.setCrate("OpenCrate remote not found")
        return
    end
    INV.cratePend = {name = e.name, display = e.display, count = #e.ids, at = now}
    INV.nextCrate = now + math.max(1, cfg.crateDelay)
    LB.send(r, e.ids[1])
    INV.setCrate("Opening " .. e.display .. ", waiting for confirmation")
end
function INV.loop()
    task.spawn(function()
        local n = 0
        while alive() do
            task.wait(1)
            n = n + 1
            pcall(INV.checkSale)
            if n % 2 == 0 then
                pcall(INV.refreshSell)
                pcall(INV.refreshCrates)
            end
            if cfg.autoOpenCrate or INV.cratePend then
                local ok, err = pcall(INV.crateStep)
                if not ok then INV.setCrate("Crate error: " .. tostring(err):sub(1, 100)) end
            end
        end
    end)
end

function LB.init()
    local rem = RS:WaitForChild("Remotes", 30)
    if not rem then
        warn("[sd] lobby: Remotes folder not found")
        return
    end
    local names = {
        Host = "Teleporters/Host", HostLeave = "Teleporters/HostLeave", Leave = "Teleporters/Leave",
        ChooseStage = "Teleporters/ChooseStage", StartCountdown = "Teleporters/StartCountdown",
        Start = "Teleporters/Start", Teleporting = "Teleporters/Teleporting",
        Summon = "Crates/Summon", OpenCrate = "Crates/OpenCrate", ClaimQuest = "Quests/ClaimQuest",
        ClaimDaily = "Daily/ClaimDaily", ClaimPass = "Battlepass/ClaimBattlepass", SellTowers = "Towers/SellTowers",
    }
    local t0 = os.clock()
    while alive() do
        local missing = 0
        for k, p in pairs(names) do
            if not LB.R[k] then
                LB.R[k] = path(rem, p)
                if not LB.R[k] then missing = missing + 1 end
            end
        end
        if missing == 0 or os.clock() - t0 > 15 then break end
        task.wait(0.5)
    end
    for k in pairs(names) do
        if not LB.R[k] then warn("[sd] lobby: missing remote " .. k) end
    end
    local R_ = LB.R
    if R_.Host and R_.Host:IsA("RemoteEvent") then
        R_.Host.OnClientEvent:Connect(function(t)
            if typeof(t) ~= "Instance" then return end
            LB.host, LB.chooseSent, LB.chooseNext = t, 0, 0
        end)
    end
    if R_.HostLeave and R_.HostLeave:IsA("RemoteEvent") then
        R_.HostLeave.OnClientEvent:Connect(function() LB.host = nil end)
    end
    if R_.StartCountdown and R_.StartCountdown:IsA("RemoteEvent") then
        R_.StartCountdown.OnClientEvent:Connect(function(t, stage, mode, canStart)
            LB.cd, LB.cdStage, LB.cdMode, LB.canStart = t, tonumber(stage), tostring(mode), canStart == true
            LB.cdAt, LB.startSent, LB.startNext = os.clock(), 0, 0
            LB.host = nil
        end)
    end
    if R_.Leave and R_.Leave:IsA("RemoteEvent") then
        R_.Leave.OnClientEvent:Connect(function() LB.cd = nil end)
    end
    if R_.Teleporting and R_.Teleporting:IsA("RemoteEvent") then
        R_.Teleporting.OnClientEvent:Connect(function()
            LB.teleporting, LB.tpAt = true, os.clock()
        end)
    end
    DATA.load()
    LB.tpNext = os.clock() + 4
    INV.loop()
    task.spawn(function()
        while alive() do
            task.wait(1)
            if cfg.autoClaimQuests or cfg.autoClaimDaily or cfg.autoClaimPass then pcall(LB.claimQuests) end
        end
    end)
    task.spawn(function()
        while alive() do
            task.wait(math.max(cfg.summonDelay, 0.5))
            if cfg.autoSummon1 or cfg.autoSummon10 then
                local ok, err = pcall(LB.summon, cfg.autoSummon10 and 10 or 1)
                if not ok then warn("[sd] summon: " .. tostring(err)) end
            end
        end
    end)
    task.spawn(function()
        while alive() do
            task.wait(0.5)
            if LB.teleporting and os.clock() - LB.tpAt > 25 then LB.teleporting = false end
            if cfg.autoTeleport and not LB.teleporting and os.clock() >= LB.tpNext then
                local ok, delay = pcall(LB.teleportStep)
                if not ok then warn("[sd] teleport: " .. tostring(delay)) end
                LB.tpNext = os.clock() + ((ok and tonumber(delay)) or 3)
            end
        end
    end)
end
mc.cb = {}
mc.selfSell = setmetatable({}, {__mode = "k"})
local TR = {}
function TR.live(e, m)
    return e ~= nil and e.gone == nil and m.Parent ~= nil
end
function TR.count()
    local n = 0
    for m, e in pairs(mc.reg) do
        if TR.live(e, m) then n = n + 1 end
    end
    return n
end
function TR.at(pos, name, skip)
    local best, bestD, bestE
    for m, e in pairs(mc.reg) do
        if TR.live(e, m) and not (skip and skip[m]) and (not name or e.name == name) then
            e.pos = TW.pos(m) or e.pos
            local d = xzDist(e.pos, pos)
            if d < 1.5 and math.abs(e.pos.Y - pos.Y) < 12 and (not bestD or d < bestD) then
                best, bestD, bestE = m, d, e
            end
        end
    end
    return best, bestE
end
function TR.add(m)
    if mc.reg[m] then return end
    local pos = TW.pos(m)
    if not pos then return end
    local base, lv = TW.base(m.Name), TW.level(m.Name)
    local oldM, oldE
    for om, e in pairs(mc.reg) do
        if om ~= m and e.name == base and xzDist(TW.pos(om) or e.pos, pos) < 1.0 and math.abs(e.pos.Y - pos.Y) < 12 then
            oldM, oldE = om, e
            break
        end
    end
    local e = {pos = pos, name = base, lv = lv, at = os.clock()}
    if oldE then
        e.key = oldE.key
        mc.reg[oldM] = nil
    end
    mc.reg[m] = e
    local c = TW.cfgOf(m)
    local tm = c and c:FindFirstChild("TargetMode")
    if tm then
        tm.Changed:Connect(function()
            if alive() and mc.cb.target then pcall(mc.cb.target, m, e) end
        end)
    end
    if oldE then
        if mc.cb.upgrade then pcall(mc.cb.upgrade, m, e, oldE) end
    elseif mc.cb.place then
        pcall(mc.cb.place, m, e)
    end
end
function TR.removed(m)
    local e = mc.reg[m]
    if not e or e.gone then return end
    e.gone = os.clock()
    task.delay(1.5, function()
        if mc.reg[m] == e then
            mc.reg[m] = nil
            if alive() and mc.cb.sell then pcall(mc.cb.sell, m, e) end
        end
    end)
end
function TR.consider(m)
    if not alive() or not m:IsA("Model") then return end
    local t0 = os.clock()
    while alive() and m.Parent do
        local c = m:FindFirstChild("Config")
        local o = c and c:FindFirstChild("Owner")
        if o and o.Value ~= "" and o.Value ~= nil then
            if o.Value == lp.Name then
                local last, same_ = nil, 0
                local t1 = os.clock()
                while alive() and m.Parent and os.clock() - t1 < 1.5 and same_ < 3 do
                    local p = TW.pos(m)
                    if p and last and (p - last).Magnitude < 0.01 then same_ = same_ + 1 else same_ = 0 end
                    last = p
                    task.wait(0.05)
                end
                if m.Parent then TR.add(m) end
            end
            return
        end
        if os.clock() - t0 > 4 then return end
        task.wait(0.1)
    end
end
function TR.connect()
    local f = TW.folder() or workspace:WaitForChild("Towers", 30)
    if not f then return false end
    f.ChildAdded:Connect(function(m) task.spawn(TR.consider, m) end)
    f.ChildRemoved:Connect(function(m) TR.removed(m) end)
    for _, m in ipairs(f:GetChildren()) do task.spawn(TR.consider, m) end
    return true
end

local MT = {}
function MT.liveSellWave()
    local txt = sellFarmInput and sellFarmInput:Get()
    if txt ~= nil then
        local w = parseWave(txt)
        cfg.sellFarmWave = (w >= 1) and w or nil
    end
    return cfg.sellFarmWave
end
function MT.invoke(r, ...)
    if not r then return false end
    local args = table.pack(...)
    local ok, res = pcall(function() return r:InvokeServer(table.unpack(args, 1, args.n)) end)
    if not ok then
        warn("[sd] " .. tostring(r.Name) .. ": " .. tostring(res))
        return false
    end
    return res
end
function MT.sellFarms(myMatch, wave)
    task.spawn(function()
        local list = {}
        for m, e in pairs(mc.reg) do
            if TR.live(e, m) and TW.isFarm(e.name) then list[#list + 1] = m end
        end
        local total = #list
        if total == 0 or not R.Sell then return end
        local function standing()
            local n = 0
            for _, m in ipairs(list) do
                local e = mc.reg[m]
                if m.Parent and TR.live(e, m) then n = n + 1 end
            end
            return n
        end
        for _ = 1, 4 do
            for _, m in ipairs(list) do
                if m.Parent and TR.live(mc.reg[m], m) then
                    mc.selfSell[m] = true
                    MT.invoke(R.Sell, m)
                    task.wait(math.max(0.1, tonumber(cfg.sellFarmDelay) or 0.1))
                end
            end
            task.wait(0.5)
            if not alive() or mc.matchId ~= myMatch then return end
            if standing() == 0 then break end
        end
        local left = standing()
        flash(string.format("Auto Sell Farms: sold %d/%d on wave %d", total - left, total, wave),
            left == 0 and "Success" or "Warning")
    end)
end
function MT.checkFarmSell()
    local w = MT.liveSellWave()
    if not cfg.autoSellFarm or not w or w <= 0 or mc.wave < w or not R.Sell then return end
    if st.farmSoldMatch == mc.matchId then return end
    st.farmSoldMatch = mc.matchId
    MT.sellFarms(mc.matchId, mc.wave)
end
function MT.clearStamps()
    mc.stamps = {Spawn = {}, Upgrade = {}, Sell = {}, Target = {}}
end
function MT.newMatch()
    if mc.rec and finishRecording then finishRecording("New match") end
    mc.matchId = mc.matchId + 1
    mc.wave = 0
    MT.clearStamps()
    mc.claim, mc.k2pos, mc.spend, mc.nextAt = {}, {}, nil, 0
    mc.finalSeen = false
    st.farmSoldMatch, st.waveStart, st.matchStart, st.matchMode = nil, nil, nil, nil
    st.skipWindow, st.skipTries = false, 0
    if MT.endReset then MT.endReset() end
    if mc.rec then
        mc.rec = false
        if recToggle then recToggle:Set(false, true) end
        flash("Recording stopped: new match")
    end
end
function MT.waveChanged(n)
    n = tonumber(n) or 0
    if n <= 0 then return end
    if (n < mc.wave) or (n == 1 and mc.finalSeen) then MT.newMatch() end
    mc.wave = n
    st.waveStart = os.clock()
    if n == 1 or not st.matchStart then st.matchStart = os.clock() end
    MT.checkFarmSell()
end
function MT.waveTime()
    return st.waveStart and (os.clock() - st.waveStart) or nil
end
function MT.replayAllowed()
    local ch = INFO.obj("Challanges")
    local isCh = ch and ch:FindFirstChild("IsChallange")
    if isCh and isCh.Value == true then return false end
    local map = INFO.val("Map")
