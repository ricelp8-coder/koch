        if ok then flash("Auto Execute: script restarted after teleport", "Success")
        else flash("Auto Execute: " .. why, "Error") end
    end
    if lastLog then flash("Auto Execute log: " .. lastLog, lastLog:find("error") and "Error" or "Success") end
else
    cfg.autoExecute = false
    UI.SetAutoExecuteToggle(false)
end
UI:Notify({
    Title = "Diamond Hub", Content = "Ready. RightShift hides the menu.", Duration = 4, Type = "Success",
})
UI.__booting = true
task.delay(8, function() UI.__booting = false end)
end, function(e)
    local tb = debug and debug.traceback
    return tb and tb(tostring(e), 2) or tostring(e)
end)
