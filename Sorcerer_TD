end
function MX.upgrade(s, myMatch)
    local want = tonumber(s.lv)
    local misses, moneyFails = 0, 0
    while same(myMatch) do
        local m, e = MX.findWait(s, myMatch)
        if not m then return false end
        local level = e.lv
        if want and level >= want then return true end
        if not TW.hasUpgrade(m) then return true end
        local margin = 1 + 0.03 * math.min(moneyFails, 10)
        local price = TW.upPrice(m) or s.c or 0
        local ready = waitUntil(function()
            local m2, e2 = MX.find(s)
            if not m2 then return false end
            if want and e2.lv >= want then return true end
            if not TW.hasUpgrade(m2) then return true end
            if MX.cash() < (TW.upPrice(m2) or price) * margin then return false end
            return os.clock() >= mc.nextAt
        end, math.huge, myMatch, 0.05)
        if not ready then return false end
        m, e = MX.findWait(s, myMatch)
        if not m then return false end
        if (want and e.lv >= want) or not TW.hasUpgrade(m) then return true end
        level = e.lv
        price = TW.upPrice(m) or price
        local before = money()
        local res = MT.invoke(R.Upgrade, m)
        MX.touch(0.35)
        if res then
            MX.reserve(before, price)
            waitUntil(function()
                local m3, e3 = MX.find(s)
                return m3 ~= nil and e3.lv > level
            end, 4, myMatch, 0.03)
            misses, moneyFails = 0, 0
        else
            mc.spend = nil
            if money() < price then
                moneyFails = moneyFails + 1
                if not sleep(0.35 + 0.15 * math.min(moneyFails, 8), myMatch) then return false end
            else
                misses = misses + 1
                if misses >= 4 then
                    flash("Upgrade rejected, step skipped", "Warning")
                    return false
                end
                if not sleep(0.5, myMatch) then return false end
            end
        end
    end
    return false
end
function MX.sell(s, myMatch)
