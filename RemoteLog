local dragging, dragStart, startPos
Title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = input
		dragStart = input.Position
		startPos = Window.Position
	end
end)
local MoveConn = UIS.InputChanged:Connect(function(input)
	if dragging and (input == dragging or input.UserInputType == Enum.UserInputType.MouseMovement) then
		local d = input.Position - dragStart
		Window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
	end
end)
local EndConn = UIS.InputEnded:Connect(function(input)
	if input == dragging or (dragging and input.UserInputType == Enum.UserInputType.MouseButton1) then dragging = nil end
end)

local function Flash(button, text)
	local old = button.Text
	button.Text = text
	task.delay(1.2, function()
		if button.Parent then button.Text = old end
	end)
end

CopyButton.MouseButton1Click:Connect(function()
	local clip = setclipboard or toclipboard or (Clipboard and Clipboard.set)
	if clip and pcall(clip, FullText()) then
		Flash(CopyButton, "Copied")
	else
		Flash(CopyButton, "No clip")
	end
end)

