local Watched = {}
local function Watch(r)
	if Watched[r] or r:IsA("RemoteFunction") then return end
	Watched[r] = true
	r.OnClientEvent:Connect(function(...)
		if State.Incoming then pcall(AddEntry, "in", r, "OnClientEvent", "", ...) end
	end)
end
-- Exec: also log calls made by executor scripts (another hub), to see what it sends
ExecButton.MouseButton1Click:Connect(function()
	State.Exec = not State.Exec
	ExecButton.Text = State.Exec and "Exec: on" or "Exec: off"
	ExecButton.BackgroundColor3 = State.Exec and ACCENT or OUTLINE
end)
local IncomingReady = false
InButton.MouseButton1Click:Connect(function()
	State.Incoming = not State.Incoming
	InButton.Text = State.Incoming and "In: on" or "In: off"
	InButton.BackgroundColor3 = State.Incoming and ACCENT or OUTLINE
	if State.Incoming and not IncomingReady then
		IncomingReady = true
		for _, d in ipairs(game:GetDescendants()) do
			if REMOTE[d.ClassName] then pcall(Watch, d) end
		end
		State.AddedConn = game.DescendantAdded:Connect(function(d)
			if REMOTE[d.ClassName] then pcall(Watch, d) end
		end)
	end
end)

IgnoreBox.FocusLost:Connect(function()
	table.clear(State.Ignore)
	for name in IgnoreBox.Text:gmatch("[^,]+") do
		name = name:match("^%s*(.-)%s*$")
		if name ~= "" then State.Ignore[string.lower(name)] = true end
	end
end)

task.spawn(function()
	while State.Active do
		task.wait(0.2)
		if State.Dirty then
			State.Dirty = false
			local atBottom = Scroll.CanvasPosition.Y >= Scroll.AbsoluteCanvasSize.Y - Scroll.AbsoluteSize.Y - 30
			local lines = {}
			local first = math.max(1, #State.Entries - MAX_SHOWN + 1)
			for i = first, #State.Entries do lines[#lines + 1] = EntryText(State.Entries[i]) end
			Log.Text = table.concat(lines, "\n")
			if atBottom then
				task.defer(function()
					Scroll.CanvasPosition = Vector2.new(0, Scroll.AbsoluteCanvasSize.Y)
				end)
			end
		end
	end
end)

State.Destroy = function()
	State.Active = false
	if State.AddedConn then State.AddedConn:Disconnect() end
	MoveConn:Disconnect()
	EndConn:Disconnect()
	Gui:Destroy()
end
