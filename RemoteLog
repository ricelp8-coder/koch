local function InstancePath(inst)
	local names = {}
	local cur = inst
	while cur and cur ~= game do
		table.insert(names, 1, cur)
		cur = cur.Parent
	end
	if cur ~= game then
		return "<" .. inst.ClassName .. " " .. inst.Name .. " (no parent)>"
	end
	local out = "game"
	for _, i in ipairs(names) do
		local name = i.Name
		if name:match("^[%a_][%w_]*$") then
			out = out .. "." .. name
		else
			out = out .. "[" .. string.format("%q", name) .. "]"
		end
	end
	return out
end

local function Ser(v, depth)
	local t = typeof(v)
	if t == "string" then
		if #v > 150 then v = v:sub(1, 150) .. "..." end
		return string.format("%q", v)
	elseif t == "number" or t == "boolean" or t == "nil" then
		return tostring(v)
	elseif t == "Instance" then
		return InstancePath(v)
	elseif t == "Vector3" then
		return string.format("Vector3.new(%s, %s, %s)", v.X, v.Y, v.Z)
	elseif t == "Vector2" then
		return string.format("Vector2.new(%s, %s)", v.X, v.Y)
	elseif t == "CFrame" then
		return "CFrame.new(" .. table.concat({ v:GetComponents() }, ", ") .. ")"
	elseif t == "Color3" then
		return string.format("Color3.new(%s, %s, %s)", v.R, v.G, v.B)
	elseif t == "EnumItem" then
		return tostring(v)
	elseif t == "buffer" then
		return "buffer(" .. buffer.len(v) .. ")"
	elseif t == "table" then
		if depth >= 3 then return "{...}" end
		local parts, n = {}, 0
		local len = #v
		for i = 1, len do
			n += 1
			if n > 40 then parts[#parts + 1] = "..." return "{" .. table.concat(parts, ", ") .. "}" end
			parts[#parts + 1] = Ser(v[i], depth + 1)
		end
		for k, x in pairs(v) do
			if not (type(k) == "number" and k >= 1 and k <= len and math.floor(k) == k) then
				n += 1
				if n > 40 then parts[#parts + 1] = "..." break end
				local key = (type(k) == "string" and k:match("^[%a_][%w_]*$")) and k or ("[" .. Ser(k, depth + 1) .. "]")
				parts[#parts + 1] = key .. " = " .. Ser(x, depth + 1)
			end
		end
		return "{" .. table.concat(parts, ", ") .. "}"
	elseif t == "function" then
		return "function"
	end
	return t .. ":" .. tostring(v)
end

local function SerArgs(...)
	local n = select("#", ...)
	local out = {}
	for i = 1, n do
		local ok, s = pcall(Ser, (select(i, ...)), 0)
		out[i] = ok and s or "?"
	end
	local text = table.concat(out, ", ")
	if #text > MAX_ARG_CHARS then text = text:sub(1, MAX_ARG_CHARS) .. "..." end
	return text
end

local function Ignored(remote)
	return State.Ignore[string.lower(remote.Name)] == true
end

local function AddEntry(direction, remote, method, caller, ...)
	if not State.Active or State.Paused then return end
	if Ignored(remote) then return end
	local call = string.format("%s:%s(%s)", InstancePath(remote), method, SerArgs(...))
	local from = caller or ""
	local last = State.Entries[#State.Entries]
	if last and last.call == call and last.from == from and last.direction == direction then
		last.count += 1
		last.time = os.date("%H:%M:%S")
	else
		State.Entries[#State.Entries + 1] = { direction = direction, call = call, from = from, count = 1, time = os.date("%H:%M:%S") }
		if #State.Entries > MAX_STORED then table.remove(State.Entries, 1) end
	end
	State.Dirty = true
end

local function EntryText(e)
	local line = string.format("[%s] %s%s%s", e.time, e.direction == "in" and "IN  " or "", e.call, e.count > 1 and ("   x" .. e.count) or "")
	if e.from ~= "" then line = line .. "\n    from: " .. e.from end
	return line
end

local function FullText()
	local lines = {}
	for i, e in ipairs(State.Entries) do lines[i] = EntryText(e) end
	return table.concat(lines, "\n")
end

local REMOTE = { RemoteEvent = true, RemoteFunction = true, UnreliableRemoteEvent = true }
local HookReady = false
-- the hook makes no namecall of its own before old(self, ...): a nested namecall (GetFullName and the like)
-- replaces the pending method, so the game's FireServer ran as something else and never reached the server.
-- Everything except reading the method and the calling script is done later in task.defer
if hookmetamethod and getnamecallmethod and newcclosure then
	if not env.__RemoteLogHooked2 then
		local old
		local ok = pcall(function()
			old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
				local sink = env.__RemoteLog
				if sink and sink.Active and typeof(self) == "Instance" then
					local method = getnamecallmethod()
					if method == "FireServer" or method == "InvokeServer" then
						local exec = checkcaller and checkcaller() or false
						if not exec or sink.Exec then
							local caller = getcallingscript and getcallingscript()
							local n = select("#", ...)
							local args = table.pack(...)
							for i = 1, n do
								if type(args[i]) == "table" then args[i] = table.clone(args[i]) end
							end
							task.defer(function()
								if not REMOTE[self.ClassName] then return end
								local callerName = exec and "executor" or ""
								if caller and not exec then
									local okC, nm = pcall(function() return caller:GetFullName() end)
									callerName = okC and nm or ""
								end
								pcall(sink.OnCall, "out", self, method, callerName, table.unpack(args, 1, n))
							end)
						end
					end
				end
				return old(self, ...)
			end))
		end)
		env.__RemoteLogHooked2 = ok
	end
	HookReady = env.__RemoteLogHooked2 == true
end
State.OnCall = AddEntry

