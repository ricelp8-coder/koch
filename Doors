local TriggerDebounce = false
local PressLog = setmetatable({}, { __mode = "k" })
local RepeatFriendly = { LongPushPrompt = true, BigPropPrompt = true, PushPrompt = true }
-- returns false when this prompt was just pressed or keeps being pressed without ever finishing
local function PressAllowed(Prompt)
	local Now = tick()
	local Rec = PressLog[Prompt]
	if not Rec then
		Rec = { n = 0, t0 = Now, last = 0, mute = 0 }
		PressLog[Prompt] = Rec
	end
	if Now < Rec.mute then return false end
	if Now - Rec.last < 0.12 then return false end
	if Now - Rec.t0 > 6 then Rec.n = 0 Rec.t0 = Now end
	Rec.n += 1
	Rec.last = Now
	if Rec.n > 14 and not RepeatFriendly[Prompt.Name] then
		Rec.mute = Now + 10
		Rec.n = 0
		return false
	end
	return true
end

