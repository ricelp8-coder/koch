local function AllCallback(Key)
	local WasAll, Busy = false, false
	return function(Value)
		if Busy or type(Value) ~= "table" then return end
		local Dropdown = Options[Key]
		if not Dropdown then return end
		local HasAll = Value["All"] == true
		local NewValue
		if HasAll and not WasAll then
			NewValue = { All = true }
			for _, Name in Dropdown.Values do
				NewValue[Name] = true
			end
		elseif not HasAll and WasAll then
			NewValue = {}
		elseif HasAll then
			for _, Name in Dropdown.Values do
				if Name ~= "All" and not Value[Name] then
					NewValue = table.clone(Value)
					NewValue.All = nil
					break
				end
			end
		end
		WasAll = (NewValue and NewValue.All == true) or (not NewValue and HasAll)
		if NewValue then
			Busy = true
			Dropdown:SetValue(NewValue)
			Busy = false
		end
	end
end

