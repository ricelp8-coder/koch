Util.BuildHud = function(Name, Title, OffsetY)
	local RED = Color3.fromHex("ff4650")
	local Hud = { Urgent = false, Placed = false }

	if not Ctx.OverlayGui then
		Ctx.OverlayGui = Instance.new("ScreenGui")
		Ctx.OverlayGui.Name = DHub.ESPKit:RandName()
		Ctx.OverlayGui.ResetOnSpawn = false
		Ctx.OverlayGui.DisplayOrder = ((Library.ScreenGui and Library.ScreenGui.DisplayOrder) or 999) - 20
		Ctx.OverlayGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		Ctx.OverlayGui.Parent = SafeParent()
		Library:OnUnload(function()
			pcall(function() Ctx.OverlayGui:Destroy() end)
			Ctx.OverlayGui = nil
		end)
	end

	local Frame = Instance.new("Frame")
	Frame.Name = Name
	Frame.AnchorPoint = Vector2.new(0.5, 0.5)
	Frame.Position = UDim2.new(0.5, 0, 0.82, OffsetY)
	Frame.Size = UDim2.fromOffset(168, 54)
	Frame.BackgroundTransparency = 0.12
	Frame.Visible = false
	Frame.Parent = Ctx.OverlayGui
	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 10)
	Corner.Parent = Frame
	local Line = Instance.new("UIStroke")
	Line.Thickness = 1.5
	Line.Parent = Frame

	local TitleLabel = Instance.new("TextLabel")
	TitleLabel.BackgroundTransparency = 1
	TitleLabel.Position = UDim2.fromOffset(0, 5)
	TitleLabel.Size = UDim2.new(1, 0, 0, 14)
	TitleLabel.Font = Enum.Font.GothamBold
	TitleLabel.Text = Title
	TitleLabel.TextSize = 11
	TitleLabel.Parent = Frame

	local ValueLabel = Instance.new("TextLabel")
	ValueLabel.BackgroundTransparency = 1
	ValueLabel.Position = UDim2.fromOffset(0, 19)
	ValueLabel.Size = UDim2.new(1, 0, 0, 30)
	ValueLabel.Font = Enum.Font.Michroma
	ValueLabel.Text = "--"
	ValueLabel.TextSize = 22
	ValueLabel.Parent = Frame

	local Bar = Instance.new("Frame")
	Bar.AnchorPoint = Vector2.new(0.5, 1)
	Bar.Position = UDim2.new(0.5, 0, 1, -4)
	Bar.Size = UDim2.new(1, -20, 0, 2)
	Bar.BorderSizePixel = 0
	Bar.Parent = Frame

	local function Accent() return Hud.Urgent and RED or Library.Scheme.AccentColor end
	local function FontColor() return Hud.Urgent and RED or Library.Scheme.FontColor end
	local Registered = {
		[Frame] = { BackgroundColor3 = "BackgroundColor" },
		[Line] = { Color = Accent },
		[TitleLabel] = { TextColor3 = "AccentColor" },
		[ValueLabel] = { TextColor3 = FontColor },
		[Bar] = { BackgroundColor3 = Accent },
	}
	for Object, Properties in Registered do
		Library:AddToRegistry(Object, Properties)
	end
	local function Repaint()
		Frame.BackgroundColor3 = Library.Scheme.BackgroundColor
		Line.Color = Accent()
		TitleLabel.TextColor3 = Library.Scheme.AccentColor
		ValueLabel.TextColor3 = FontColor()
		Bar.BackgroundColor3 = Accent()
	end
	Repaint()

	function Hud:Place()
		if Hud.Placed then return end
		local MainUI = LocalPlayer.PlayerGui:FindFirstChild("MainUI")
		local MainFrame = MainUI and MainUI:FindFirstChild("MainFrame")
		local Caption = MainFrame and MainFrame:FindFirstChild("Caption")
		if Caption then
			Frame.AnchorPoint = Caption.AnchorPoint
			Frame.Position = Caption.Position + UDim2.fromOffset(0, OffsetY)
			Hud.Placed = true
		end
	end
	function Hud:SetVisible(Visible)
		Frame.Visible = Visible and true or false
		if Visible then Hud:Place() end
	end
	function Hud:SetText(Text, Urgent)
		ValueLabel.Text = Text
		Hud.Urgent = Urgent and true or false
		Repaint()
	end
	Library:OnUnload(function()
		for Object in Registered do
			Library.Registry[Object] = nil
		end
		pcall(function() Frame:Destroy() end)
	end)
	return Hud
end

