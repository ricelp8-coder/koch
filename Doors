		Stripe.BackgroundColor3 = Library.Scheme.AccentColor
		Stripe.BorderSizePixel = 0
		Stripe.Size = UDim2.new(0, 4, 1, 0)
		Stripe.Parent = Card

		local Heading = Instance.new("TextLabel")
		Heading.Name = "Title"
		Heading.BackgroundTransparency = 1
		Heading.Position = UDim2.fromOffset(16, 7)
		Heading.Size = UDim2.new(1, -26, 0, 16)
		Heading.Font = Enum.Font.GothamBold
		Heading.Text = TitleText or "..."
		Heading.TextColor3 = Library.Scheme.AccentColor
		Heading.TextSize = 13
		Heading.TextTruncate = Enum.TextTruncate.AtEnd
		Heading.TextXAlignment = Enum.TextXAlignment.Left
		Heading.Parent = Card

		local Body = Instance.new("TextLabel")
		Body.Name = "Description"
		Body.BackgroundTransparency = 1
		Body.Position = UDim2.fromOffset(16, 25)
		Body.Size = UDim2.new(1, -26, 0, 26)
		Body.Font = Enum.Font.Gotham
		Body.Text = Desc or "..."
		Body.TextColor3 = Library.Scheme.FontColor
		Body.TextTransparency = 0.15
		Body.TextSize = 12
		Body.TextWrapped = true
		Body.TextXAlignment = Enum.TextXAlignment.Left
		Body.TextYAlignment = Enum.TextYAlignment.Top
		Body.Parent = Card

		local Timer = Instance.new("Frame")
		Timer.Name = "Line"
		Timer.BackgroundColor3 = Library.Scheme.AccentColor
		Timer.BackgroundTransparency = 0.3
		Timer.BorderSizePixel = 0
		Timer.AnchorPoint = Vector2.new(0, 1)
		Timer.Position = UDim2.new(0, 4, 1, 0)
		Timer.Size = UDim2.new(1, -4, 0, 2)
		Timer.Parent = Card

		NotificationLibrary.LiveNotifications += 1
		NotificationLibrary.Notifications += 1

		Services.TweenService:Create(Card, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{ Position = UDim2.new(1, NOTE_REST, 1, -(NOTE_H + 20) - NOTE_STEP * Slot) }):Play()
		Card:SetAttribute("CurrentPosition", UDim2.new(1, NOTE_REST, 1, -(NOTE_H + 20) - NOTE_STEP * Slot))

		task.wait(0.25)
		if typeof(Delay) == "Instance" then
			Delay.Destroying:Wait()
		else
			Services.TweenService:Create(Timer, TweenInfo.new(Delay - 0.25, Enum.EasingStyle.Linear),
				{ Size = UDim2.new(0, 0, 0, 2) }):Play()
			task.wait(Delay - 0.25)
		end

		Card:SetAttribute("Destroying", true)
		local Rest = Card:GetAttribute("CurrentPosition")
		Services.TweenService:Create(Card, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
			{ Position = UDim2.new(1, NOTE_HIDDEN, Rest.Y.Scale, Rest.Y.Offset) }):Play()

		NotificationLibrary.LiveNotifications -= 1

		-- newer cards (above in the stack) drop down into the freed slot
		local MyId = Card:GetAttribute("ID")
		for _, Other in Container:GetChildren() do
			if Other.Name == "Notification" and Other ~= Card
				and (Other:GetAttribute("ID") or 0) > MyId
				and Other:GetAttribute("Destroying") ~= true
			then
				local Pos = Other:GetAttribute("CurrentPosition")
				local Down = UDim2.new(Pos.X.Scale, Pos.X.Offset, Pos.Y.Scale, Pos.Y.Offset + NOTE_STEP)
				Other:SetAttribute("CurrentPosition", Down)
				Services.TweenService:Create(Other, TweenInfo.new(0.4, Enum.EasingStyle.Quint), { Position = Down }):Play()
			end
		end

		task.wait(0.45)
		Card:Destroy()
	end)
end

