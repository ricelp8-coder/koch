        if UIX.active == "Diamond UI" then
            return ok and '<font color="rgb(70,210,130)">OK</font>' or '<font color="rgb(240,85,95)">NO</font>'
        end
        return ok and "\226\156\133" or "\226\157\140"
    end
    function UIX.load(file)
        local src = game:HttpGet(UIX.base .. file .. ".lua")
        local fn, err = loadstring(src)
        if not fn then error(file .. ": " .. tostring(err), 0) end
        return fn(UIX, "dh")
    end
    UIX.build = {
        ["Obsidian UI"] = function() return UIX.load("ObsidianUI") end,
        ["Diamond UI"] = function() return UIX.load("DiamondUI") end,
    }
    function UIX.make()
        local first = UIX.get()
        local other = first == "Diamond UI" and "Obsidian UI" or "Diamond UI"
        local ok, lib = pcall(UIX.build[first])
        if not ok or not lib then
            warn("[DiamondHub] " .. first .. " failed to load: " .. tostring(lib))
            UIX.active = other
            lib = UIX.build[other]()
        else
            UIX.active = first
        end
        return lib
    end
end

