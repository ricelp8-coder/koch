		Card:SetAttribute("ID", NotificationLibrary.Notifications)
		Card:SetAttribute("CurrentPosition", Card.Position)

		local Round = Instance.new("UICorner")
		Round.CornerRadius = UDim.new(0, 8)
		Round.Parent = Card
		local Edge = Instance.new("UIStroke")
		Edge.Color = Library.Scheme.AccentColor
		Edge.Transparency = 0.6
		Edge.Thickness = 1
