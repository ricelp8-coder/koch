local function MakeGhost(Idx, Info, Kind)
	Info = type(Info) == "table" and Info or {}
	local Element = { Ghost = true, Type = Kind, Idx = Idx, Saved = nil }
	if Kind == "Toggle" then
		Element.Value = false
	elseif Kind == "Dropdown" then
		local Default = Info.Default
		if Info.Multi then
			Element.Value = {}
			if type(Default) == "table" then
				for Key, Entry in Default do
					if type(Key) == "number" and type(Entry) == "string" then
						Element.Value[Entry] = true
					elseif Entry == true then
						Element.Value[Key] = true
					end
				end
			end
		else
			Element.Value = type(Default) == "number" and Info.Values and Info.Values[Default] or Default
		end
	else
		Element.Value = Info.Default
	end
	Element.Mode = Info.Mode
	function Element:GetState() return false end
	function Element:AddKeyPicker(KeyIdx, KeyInfo)
		local Picker = MakeGhost(KeyIdx, KeyInfo, "KeyPicker")
		Library.Options[KeyIdx] = Picker
		return Picker
	end
	function Element:AddColorPicker(ColorIdx, ColorInfo)
		local Picker = MakeGhost(ColorIdx, ColorInfo, "ColorPicker")
		Library.Options[ColorIdx] = Picker
		return Picker
	end
	setmetatable(Element, {
		__index = function(_, Key)
			if type(Key) == "string" and string.find(Key, "^Add") or string.find(Key, "^Set") or string.find(Key, "^On") or string.find(Key, "^Get")
				or string.find(Key, "^Update") or string.find(Key, "^Refresh") or string.find(Key, "^Destroy") or string.find(Key, "^Show")
				or string.find(Key, "^Hide") or string.find(Key, "^Display") or string.find(Key, "^Resize") or string.find(Key, "^Run") then
				return function(Self, ...) return Self end
			end
		end,
	})
	return Element
end

local function NullBox()
	local Box = {}
	local function Register(Idx, Info, Kind)
		local Element = MakeGhost(Idx, Info, Kind)
		if type(Idx) == "string" then
			if Kind == "Toggle" then
				Library.Toggles[Idx] = Element
			else
				Library.Options[Idx] = Element
			end
		end
		return Element
	end
