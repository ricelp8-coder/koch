            writefile(UIX.file, v)
        end)
    end
    function UIX.switch(choice, unload)
        if UIX.switching or choice == UIX.active then return false end
        UIX.switching = true
        UIX.set(choice)
        task.spawn(function()
            pcall(unload)
            if UIX.post then pcall(UIX.post) end
