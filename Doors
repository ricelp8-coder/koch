	if Floor ~= "Rooms" or not Toggles.RoomsRun.Value or Ctx.RoomRunOn or not CollisionPart or LatestRoom.Value >= 1000 then return end
	Ctx.RoomRunOn = true

	local Path = Services.PathfindingService:CreatePath({
