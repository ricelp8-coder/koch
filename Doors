local function BuildEnvironment()
	local genv = (getgenv and getgenv()) or _G
	local root = (getfenv and getfenv(0)) or genv
	local executor = "Unknown"
	pcall(function()
		if identifyexecutor then executor = tostring((identifyexecutor())) end
	end)
	local Broken = {
		Volcano = { run_on_actor = true, oth = true },
		Opiumware = { gethiddenproperty = true },
		Solara = { require = true },
		Xeno = { require = true },
	}
	local Skip = {}
	for Name, List in pairs(Broken) do
		if executor:find(Name, 1, true) then
			for Key in pairs(List) do Skip[Key] = true end
		end
	end
	local Environment = { Executor = executor }
	return setmetatable(Environment, {
		__index = function(_, Name)
			if type(Name) ~= "string" or Skip[Name] then return nil end
			local Value = root[Name]
			if Value == nil then Value = genv[Name] end
			if type(Value) == "function" or type(Value) == "table" then return Value end
			return nil
		end,
	})
end

