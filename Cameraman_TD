function INV.cratePrice(n)
  local crate = cfg.buyCrateName
  local lbl = INV.path(pg, "Main/Main/Battlepass/BattlepassFrame/Shop/List/ScrollingFrame/" .. crate .. "/CrateInfo/BuyCrates/" .. n .. "/Price")
  local txt = lbl and tostring(lbl.Text) or ""
