        if (mc.id2lvl[id] or 1) > level then
            misses, moneyFails = 0, 0
        elseif not mc.id2pos[id] then
            return false
        elseif (mc.upFailAt or 0) >= sentAt then
            mc.spend = nil
            moneyFails = moneyFails + 1
            if not sleep(0.35 + 0.15 * math.min(moneyFails, 8), myMatch) then return false end
        elseif not mc.ackSeen and chargeVisible(sentAt, base) then
            mc.id2lvl[id] = level + 1
            misses, moneyFails = 0, 0
        else
            mc.spend = nil
            misses = misses + 1
            if misses >= 3 then
                flash("Upgrade unconfirmed, step skipped", "Warning")
                return false
            end
            if not sleep(0.5, myMatch) then return false end
        end
    end
    return false
end
