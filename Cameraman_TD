            local low = btnText(againBtn):lower()
            local cancelled = low:find("cancel", 1, true) or low:find("h\225\187\167y", 1, true) or low:find("hu\225\187\179", 1, true)
            local vt = finalBtn("Vote")
            vt = vt and vt:FindFirstChild("Time")
            local left = vt and visible(vt) and tonumber(vt.Text)
            if cancelled then
                if not END.deadline then END.deadline = now + (left or 0) + 8 end
                if now < END.deadline then END.nextAt = now + 0.5 return end
                END.deadline = nil
            end
            if END.sent >= 3 then
                flash("Replay stalled, returning to lobby", "Warning")
                END.sent = END.sent + 1
                toLobby(math.min(END.sent - 3, 3))
                END.nextAt = now + 6
                return
            end
            END.sent = END.sent + 1
            R.PlayAgain:FireServer()
            if END.sent == 2 then press(againBtn) end
            END.nextAt = now + 4
        end
    end
    task.spawn(function()
        local n = 0
        while alive() do
            task.wait(0.1)
            n = n + 1
            if votingOpen() then
                if not st.inVote then
                    st.inVote, st.voted = true, false
                    st.voteTries = 0
                    newMatch()
                end
                st.finalShown = false
                local voteMode
                if eventVotingOpen() then
                    voteMode = cfg.autoVoteEvent and cfg.eventMode or (cfg.autoVote and cfg.mode or nil)
                elseif cfg.autoVote then
                    voteMode = cfg.mode
                end
                if voteMode then
                    local now = os.clock()
                    if not st.voted or ((st.voteTries or 0) < 3 and now - (st.voteLast or 0) > 1.5) then
                        st.voted = true
                        st.voteTries = (st.voteTries or 0) + 1
                        st.voteLast = now
                        local mode = voteMode
                        st.matchMode = mode
                        R.ModeVote:FireServer(mode)
                    end
                end
            else
                st.inVote = false
                if finalOpen() then
                    matchEnded()
                    st.finalShown = true
                    if cfg.endAction ~= "None" then
                        local ok, err = pcall(END.step, cfg.endAction)
                        if not ok then warn("[cm] endAction: " .. tostring(err)) end
                    end
                else
                    st.finalShown = false
                    if END.active then END.reset() end
                end
            end
            ensureSpeed()
            if st.curSpeed == tonumber(cfg.speed) then st.speedTries, st.speedGaveUp = 0, false end
            if n % 10 == 0 then
                local line
                if mc.running then
                    line = string.format("PLAYING %d/%d", mc.stepNo, #mc.steps)
                elseif mc.play then
                    line = "ARMED (waits for a match)"
                elseif mc.rec then
                    line = "RECORDING"
                else
                    line = nil
                end
                macroStatus:SetText(string.format("steps <b>%d</b> | wave <b>%d</b> | $<b>%d</b>%s",
                    #mc.steps, mc.wave, math.floor(money()), line and ("\n" .. line) or ""))
            end
        end
    end)
    refreshMacroList()
end
