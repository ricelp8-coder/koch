function MX.cadence(myMatch)
    return waitUntil(function() return os.clock() >= (mc.nextUpAt or 0) end, 3, myMatch, 0.02)
end
function MX.place(s, myMatch)
    local p = a2v(s.p)
    mc.claim = mc.claim or {}
    local have = idAt(p, s.n, mc.claim)
    if have then
        mc.claim[have] = true
        return true, have
    end
    pruneGhosts()
    local attempts, moneyFails = 0, 0
    while same(myMatch) do
        local there = idAt(p, s.n, mc.claim)
        if there then
            mc.claim[there] = true
            return true, there
        end
        local margin = 1 + 0.03 * math.min(moneyFails, 10)
        local base = 0
        local ready = waitUntil(function()
            there = idAt(p, s.n, mc.claim)
            if there then return true end
            base = tdPrice(s.n, 1) or s.c or 0
            if MX.cash() < base * margin then return false end
            if slotsFull() then return false end
            return os.clock() >= math.max(mc.nextPlaceAt or 0, mc.nextUpAt or 0)
        end, math.huge, myMatch, 0.02)
        if not ready then return false end
        if there then
            mc.claim[there] = true
            return true, there
        end
        local unitId = resolveUnit(s.n, s.u)
        local before = money()
        mc.waitPlace, mc.waitName, mc.waitPlaceOk, mc.waitPlaceId, mc.placeFail = p, s.n, false, nil, nil
        local cf = CFrame.new(p)
        if type(s.cf) == "table" and #s.cf == 12 then
            local okc, v = pcall(function() return CFrame.new(table.unpack(s.cf)) end)
            if okc and typeof(v) == "CFrame" then cf = v end
        end
        R.TowerAdd:FireServer({Pos = p, CFrame = cf, Name = s.n, UnitId = unitId})
        mc.nextPlaceAt = os.clock() + 0.5
        mc.nextUpAt = os.clock() + 0.35
        MX.reserve(before, base)
        attempts = attempts + 1
        waitUntil(function()
            return mc.waitPlaceOk or mc.placeFail ~= nil or idAt(p, s.n, mc.claim) ~= nil
        end, 2.5, myMatch, 0.02)
        local nid = mc.waitPlaceId or idAt(p, s.n, mc.claim)
        local fail = mc.placeFail
        if not nid and fail == nil and same(myMatch) then
            -- no answer yet: give a late receipt time to arrive before sending again
            waitUntil(function()
                nid = mc.waitPlaceId or idAt(p, s.n, mc.claim)
                return nid ~= nil or mc.placeFail ~= nil
            end, 3, myMatch, 0.03)
            fail = mc.placeFail
        end
        mc.waitPlace, mc.waitName = nil, nil
        if nid then
            mc.claim[nid] = true
            return true, nid
        end
        if not same(myMatch) then return false end
        mc.spend = nil
        if fail == "limit" then
            flash(tostring(s.n) .. " rejected by the server (placement limit), step skipped", "Warning")
            return false
        elseif fail == "money" then
            moneyFails = moneyFails + 1
            if not sleep(0.35 + 0.15 * math.min(moneyFails, 8), myMatch) then return false end
        else
            if attempts >= 5 then
                flash("Place failed, step skipped", "Warning")
                return false
            end
            if not sleep(0.6, myMatch) then return false end
        end
    end
    return false
end
function MX.upgrade(s, myMatch)
    local id = stepId(s)
    if not id then return false end
    local want = tonumber(s.lv) or ((mc.id2lvl[id] or 1) + 1)
    local misses, moneyFails = 0, 0
    while same(myMatch) do
        if not mc.id2pos[id] then return false end
        local name = mc.id2name[id]
        local level = mc.id2lvl[id] or 1
        if level >= want then return true end
        local maxL = tdMaxLevel(name)
        if maxL and level >= maxL then return true end
        local margin = 1 + 0.03 * math.min(moneyFails, 10)
        local base = 0
        local ready = waitUntil(function()
            if not mc.id2pos[id] then return true end
            local lv = mc.id2lvl[id] or 1
            if lv >= want then return true end
            base = tdPrice(name, lv + 1) or ((lv + 1 == want) and s.c) or 0
            if MX.cash() < base * margin then return false end
            return os.clock() >= (mc.nextUpAt or 0)
        end, math.huge, myMatch, 0.02)
        if not ready then return false end
        if not mc.id2pos[id] then return false end
        level = mc.id2lvl[id] or 1
        if level >= want then return true end
        local before = money()
        local sentAt = os.clock()
        R.TowerUpgrade:FireServer({Id = mc.id2raw[id] or id})
        mc.nextUpAt = sentAt + 0.35
        MX.reserve(before, base)
        waitUntil(function()
            if (mc.id2lvl[id] or 1) > level or not mc.id2pos[id] then return true end
            if (mc.upFailAt or 0) >= sentAt then return true end
            return not mc.ackSeen and chargeVisible(sentAt, base)
        end, 12, myMatch, 0.02)
