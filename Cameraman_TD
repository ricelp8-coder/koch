        if gate(s, myMatch) then
            if s.t == "place" then
                local ok, id = MX.place(s, myMatch)
                if ok and id and s.k then mc.k2id[s.k] = id end
            elseif s.t == "upgrade" then
                MX.upgrade(s, myMatch)
            elseif s.t == "sell" then
                doSell(s, myMatch)
            elseif s.t == "target" then
                doTarget(s, myMatch)
            elseif s.t == "skip" then
                doSkip(s, myMatch)
            elseif s.t == "ability" then
                doAbility(s, myMatch)
            end
            task.wait()
        end
    end
    local finished = same(myMatch) and mc.stepNo >= #mc.steps
    mc.playing = false
    if mc.learned and sel and sel == mc.selected and steps == mc.steps then
        mc.learned = false
        if MAC.write(sel, {v = 3, replay = mc.replay, steps = mc.steps}) then
            flash("Macro calibrated: prices saved", "Success")
        end
    end
    if finished then flash("Macro finished, waiting for the next match", "Success") end
end
local function assignKeys(steps)
    local alive, lv, n = {}, {}, 0
    for _, s in ipairs(steps) do
        local p = a2v(s.p)
        if s.t == "skip" then
            -- wave skip step: no tower attached
        elseif s.t == "place" then
            n = n + 1
            s.k = s.k or ("L" .. n)
            alive[s.k] = {pos = p, name = s.n}
            lv[s.k] = 1
        else
            if not s.k then
                local best, bestD
                for k, a in pairs(alive) do
                    local d = (a.pos - p).Magnitude
                    if d < POS_EPS and (not bestD or d < bestD) then best, bestD = k, d end
                end
                s.k = best
            end
            if s.k then
                if s.t == "upgrade" then
                    if s.lv then
                        lv[s.k] = s.lv
                    else
                        lv[s.k] = (lv[s.k] or 1) + 1
                        s.lv = lv[s.k]
                    end
                elseif s.t == "sell" then
                    alive[s.k] = nil
                end
            end
        end
    end
end
local function cleanSteps(arr)
    local out = {}
    if type(arr) ~= "table" then return out end
    for _, s in ipairs(arr) do
        if type(s) == "table" and type(s.t) == "string" and type(s.p) == "table"
            and type(s.p[1]) == "number" and type(s.p[2]) == "number" and type(s.p[3]) == "number" then
            table.insert(out, s)
        end
    end
    return out
end
local function macroPlan(steps)
    local total, unknown, towers = 0, 0, {}
    local function key(pp) return string.format("%.2f,%.2f,%.2f", pp[1], pp[2], pp[3]) end
    for _, st2 in ipairs(steps) do
        local k = key(st2.p)
        if st2.t == "place" then
            towers[k] = {name = st2.n, level = 1}
            local pr = tdPrice(st2.n, 1)
            if pr then total = total + pr else unknown = unknown + 1 end
        elseif st2.t == "upgrade" then
            local tw = towers[k]
            if tw then
                local mx = tdMaxLevel(tw.name)
                if not mx or tw.level < mx then
                    local pr = tdPrice(tw.name, tw.level + 1)
                    if pr then total = total + pr else unknown = unknown + 1 end
                    tw.level = tw.level + 1
                end
            else
                unknown = unknown + 1
            end
        elseif st2.t == "sell" then
            towers[k] = nil
        end
    end
    return total, unknown
end
local function refreshMacroList()
    if macroDD then macroDD:SetOptions(MAC.list()) end
end
local function loadMacro(name, silent)
    local d = MAC.read(name)
    local steps = d and cleanSteps(d.steps) or {}
    if #steps == 0 then
        if not silent then flash("Macro not found or empty: " .. tostring(name), "Error") end
        return false
    end
    assignKeys(steps)
    mc.steps = steps
    mc.map = (type(d.map) == "string" and d.map ~= "") and d.map or nil
    mc.selected = name
    MAC.setAuto(name)
    if macroDD then macroDD:Set(name, true) end
    if nameInput then nameInput:Set(name, true) end
    if not silent then
        local total = TD.towers and macroPlan(steps) or 0
        if total > 0 then
            flash("Loaded macro: " .. name .. " (" .. #steps .. " steps, about $" .. fmtMoney(total) .. ")", "Success")
        else
            flash("Loaded macro: " .. name .. " (" .. #steps .. " steps)", "Success")
        end
    end
    return true
end
local function saveMacro()
    local n = sanitize(nameInput:Get())
    if n == "" then
        flash("Enter a macro name first", "Warning")
        return
    end
    if #mc.steps == 0 then
        flash("Nothing to save: record a macro first", "Warning")
        return
    end
    if MAC.write(n, {v = 2, replay = mc.replay, map = mc.map or currentMap(), steps = mc.steps}) then
        mc.selected = n
        MAC.setAuto(n)
        refreshMacroList()
        macroDD:Set(n, true)
        flash("Saved macro: " .. n .. " (" .. #mc.steps .. " steps)", "Success")
    else
        flash("Save failed", "Error")
    end
end
local function deleteMacro()
    local n = sanitize(nameInput:Get())
    if n == "" then n = mc.selected or "" end
    if n == "" or not MAC.exists(n) then
        flash("Pick a saved macro to delete", "Warning")
        return
    end
    if MAC.delete(n) then
        if mc.selected == n then
            mc.selected = nil
            mc.steps, mc.map = {}, nil
            MAC.setAuto(nil)
        end
        refreshMacroList()
        macroDD:Set(nil, true)
        flash("Deleted macro: " .. n, "Success")
    else
        flash("Delete failed", "Error")
    end
end
local function nextMacroName()
    local n = 1
    while MAC.exists("macro #" .. n) do n = n + 1 end
    return "macro #" .. n
end
local function importMacro()
    if mc.play or mc.rec then
        flash("Turn Record / Play off first", "Warning")
        return
    end
    local raw = tostring(importJson:Get() or ""):match("^%s*(.-)%s*$")
    if raw == "" then
        flash("Paste the macro JSON first", "Warning")
        return
    end
    local ok, d = pcall(function() return game:GetService("HttpService"):JSONDecode(raw) end)
    if not ok or type(d) ~= "table" then
        flash("Import failed: invalid JSON", "Error")
        return
    end
    local steps = cleanSteps(type(d.steps) == "table" and d.steps or d)
    if #steps == 0 then
        flash("Import failed: no valid steps", "Error")
        return
    end
    local name = sanitize(importName:Get())
    if name == "" and type(d.name) == "string" then name = sanitize(d.name) end
    if name == "" then name = nextMacroName() end
    local replay = (d.replay == "Time" or d.replay == "Money" or d.replay == "Hybrid") and d.replay or mc.replay
    local map = (type(d.map) == "string" and d.map ~= "") and d.map or nil
    if not MAC.write(name, {v = 2, replay = replay, map = map, steps = steps}) then
        flash("Import failed: could not save", "Error")
        return
    end
    refreshMacroList()
    loadMacro(name, true)
    importJson:Set("", true)
    importName:Set("", true)
    flash("Imported macro: " .. name .. " (" .. #steps .. " steps)", "Success")
end
local function exportMacro()
    local n = mc.selected or sanitize(nameInput:Get())
    local d = n and n ~= "" and MAC.read(n)
    if not d then
        flash("Pick a saved macro to copy", "Warning")
        return
    end
    d.name = n
    if type(setclipboard) ~= "function" then
        flash("setclipboard is not supported here", "Error")
        return
    end
    setclipboard(game:GetService("HttpService"):JSONEncode(d))
    flash("Macro JSON copied: " .. n, "Success")
end
-- "go" = run, "wait" = map not readable yet, "block" = recorded on another map
local function mapGate()
    if not mc.map then return "go" end
    local cur = currentMap()
    if cur then
        if normMap(cur) == normMap(mc.map) then return "go" end
        mc.ranMatch = mc.matchId
        return "block"
    end
    if mc.mapWaitMatch ~= mc.matchId then
        mc.mapWaitMatch, mc.mapWaitAt = mc.matchId, os.clock()
    end
    if os.clock() - mc.mapWaitAt < 10 then return "wait" end
    return "go"
end
finishRecording = function(why)
    if not mc.rec then return end
    clearStamps()
    mc.rec = false
    syncToggles()
    if #mc.steps == 0 then
        flash(why .. ": nothing was recorded", "Warning")
        return
    end
    if mc.autoSave == false then
        flash(why .. ": recording stopped, " .. #mc.steps .. " steps kept (press Save)")
