end
-- Rank rewards (Path of Honor): a rank is claimable when OwnedRanks[name] is true, ClaimedRanks[name] is not
-- and its config entry carries rewards. The server takes the rank name as a plain string.
function LB.rankHasRewards(name)
    local ok, res = pcall(function()
        local cf = RS.ModuleLoader.Configs.Config
        local entry = require(cf).GameSettings.PathHonor[name]
        return type(entry) == "table" and type(entry.Rewards) == "table" and next(entry.Rewards) ~= nil
    end)
    if ok then return res end
    return true -- config unreadable: let the server decide
end
function LB.rankOrder(name)
    local ok, exp = pcall(function() return require(RS.ModuleLoader.Configs.Config).GameSettings.PathHonor[name].RequiredEXP end)
    return ok and tonumber(exp) or math.huge
end
function LB.claimRanks(data)
    local r = LB.R.ClaimRankReward
    if not (r and cfg.autoClaimRanks) then return end
    local ranks = data and data.Ranks
    if type(ranks) ~= "table" or type(ranks.OwnedRanks) ~= "table" then return end
    local claimed = type(ranks.ClaimedRanks) == "table" and ranks.ClaimedRanks or {}
    local names = {}
    for name, owned in pairs(ranks.OwnedRanks) do
        if owned == true and type(name) == "string" and claimed[name] ~= true and LB.rankHasRewards(name) then
            names[#names + 1] = name
        end
    end
    table.sort(names, function(a, b)
        local oa, ob = LB.rankOrder(a), LB.rankOrder(b)
        if oa == ob then return a < b end
        return oa < ob
    end)
    for _, name in ipairs(names) do
        if not cfg.autoClaimRanks then break end
        LB.questClaim("Rank/" .. name, r, name)
    end
end
function LB.claimQuests()
    if LB.questBusy then return end
    if not (cfg.autoClaimQuests or cfg.autoClaimHalloween or cfg.autoClaimRanks) then return end
    if LB.inMatch() or LB.teleporting then return end
    LB.questBusy = true
    local ok, err = pcall(function()
        local data = INV.get()
        local rq = LB.R.CollectQuest
        if cfg.autoClaimQuests and rq then
            local active = data and data.ActiveQuests
            if type(active) == "table" then
                for kind, group in pairs(active) do
                    if type(kind) == "string" and type(group) == "table" and type(group.Quests) == "table" then
                        local stamp = tostring(group.LastUpdate or 0)
                        for _, q in pairs(group.Quests) do
                            if not cfg.autoClaimQuests then break end
                            if questDone(q) and type(q.Id) == "string" then
                                LB.questClaim(stamp .. "/" .. kind .. "/" .. q.Id, rq, q.Id, kind)
                            end
                        end
                    end
                end
            elseif not data then
                for _, id in ipairs(LB.guiQuests()) do
                    if not cfg.autoClaimQuests then break end
                    LB.questClaim("GUI/Daily/" .. id, rq, id, "Daily")
                end
            end
        end
        local rp = LB.R.CollectPassQuest
        local bp = data and type(data.Battlepass) == "table" and data.Battlepass or nil
        if cfg.autoClaimHalloween and bp then
            local pq = bp.PassQuests
            if rp and type(pq) == "table" and type(pq.Quests) == "table" then
                local stamp, ids = tostring(pq.LastUpdate or 0), {}
                for _, q in pairs(pq.Quests) do
                    if questDone(q) and type(q.Id) == "string" then ids[#ids + 1] = q.Id end
                end
                table.sort(ids)
                for _, id in ipairs(ids) do
                    if not cfg.autoClaimHalloween then break end
                    LB.questClaim(stamp .. "/Pass/" .. id, rp, id)
                end
            end
            if cfg.autoClaimHalloween then LB.claimTiers(bp) end
        end
        if cfg.autoClaimRanks then LB.claimRanks(data) end
    end)
    LB.questBusy = false
    if not ok then warn("[cm] quests: " .. tostring(err)) end
end
function LB.init(ev, fn)
    local wanted = {SummonTowers = true, ElevatorEnter = true, ElevatorStart = true, ElevatorEntered = true,
        ElevatorLeave = true, ElevatorLeft = true,
        ElevatorTeleporting = true, ElevatorSetModifiers = true, ElevatorModifiersUpdated = true,
        CollectQuest = true, CollectPassQuest = true, ClaimTier = true, SendPassQuestData = true, ClaimRankReward = true,
        SellPart = true, BuyCrate = true, OpenCrate = true}
    local function adopt(r)
        if not wanted[r.Name] or LB.R[r.Name] then return end
        LB.R[r.Name] = r
        if not r:IsA("RemoteEvent") then return end
        if r.Name == "ElevatorEntered" then
            r.OnClientEvent:Connect(function(name, host)
                LB.elev, LB.isHost, LB.startReq = name, host == true, nil
                LB.elevMods[name] = nil
                LB.modStarted, LB.modFinished = nil, nil
                if cfg.autoModifier and LB.isHost then LB.runModifier(name) end
            end)
        elseif r.Name == "ElevatorLeft" then
            r.OnClientEvent:Connect(function()
                LB.elev, LB.isHost, LB.startReq = nil, false, nil
                LB.modStarted, LB.modFinished = nil, nil
            end)
        elseif r.Name == "ElevatorModifiersUpdated" then
            r.OnClientEvent:Connect(function(name, list)
                LB.elevMods[name] = type(list) == "table" and list or {}
            end)
        elseif r.Name == "SendPassQuestData" then
            r.OnClientEvent:Connect(function()
                if cfg.autoClaimQuests or cfg.autoClaimHalloween or cfg.autoClaimRanks then task.delay(0.5, LB.claimQuests) end
            end)
        elseif r.Name == "ElevatorTeleporting" then
            r.OnClientEvent:Connect(function()
                LB.teleporting = true
                LB.tpEventAt = os.clock()
                LB.modStarted, LB.modFinished = nil, nil
            end)
        end
    end
    for _, folder in ipairs({ev, fn}) do
        for _, r in ipairs(folder:GetChildren()) do adopt(r) end
        folder.ChildAdded:Connect(adopt)
    end
