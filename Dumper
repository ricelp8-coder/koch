local function HandlerLines(remote)
	local out = {}
	if Caps.getconnections then
		local signal = nil
		if not remote:IsA("RemoteFunction") then signal = remote.OnClientEvent end
		if signal then
			local ok, conns = pcall(Caps.getconnections, signal)
			if ok and type(conns) == "table" then
				for _, c in ipairs(conns) do
					local f = c.Function
					if type(f) == "function" then
						local ok2, src, line, name = pcall(debug.info, f, "sln")
						if ok2 then
							out[#out + 1] = "    handler: " .. ((name and name ~= "") and name or "anonymous") .. " @ " .. tostring(src) .. ":" .. tostring(line)
						else
							out[#out + 1] = "    handler: <c function>"
						end
					else
						out[#out + 1] = "    handler: <no function>"
					end
				end
			end
		end
	end
	if remote:IsA("RemoteFunction") and Caps.getcallbackvalue then
		local ok, cb = pcall(Caps.getcallbackvalue, remote, "OnClientInvoke")
		if ok and type(cb) == "function" then
			local ok2, src, line, name = pcall(debug.info, cb, "sln")
			out[#out + 1] = "    OnClientInvoke: " .. (ok2 and (((name and name ~= "") and name or "anonymous") .. " @ " .. tostring(src) .. ":" .. tostring(line)) or "<c function>")
		end
	end
	return out
end

