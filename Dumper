Phase("tree.txt", function()
	local lines = {}
	local y = Yielder(CONFIG.TreeYieldEvery)
	local nodes = 0
	local function valueOf(i)
		if i:IsA("ValueBase") then
			local ok, v = pcall(function() return i.Value end)
			if ok then return " = " .. Ser(v, 1) end
		end
		return ""
	end
	local function attrsOf(i)
		local ok, a = pcall(function() return i:GetAttributes() end)
		if ok and next(a) then return " " .. Ser(a, 1) end
		return ""
	end
	local function walk(i, depth, maxDepth)
		y()
		nodes += 1
		if nodes > CONFIG.TreeMaxNodes then return end
		local okLine, line = pcall(function()
			return string.rep("  ", depth) .. i.Name .. " [" .. i.ClassName .. "]" .. (CONFIG.TreeDetails and (valueOf(i) .. attrsOf(i)) or "")
		end)
		if not okLine then return end
		lines[#lines + 1] = line
		if depth >= maxDepth then return end
		local ok, kids = pcall(function() return i:GetChildren() end)
		if not ok then return end
		if #kids > CONFIG.TreeMaxChildren then
			local counts = {}
			for _, k in ipairs(kids) do
				local key = k.Name .. " [" .. k.ClassName .. "]"
				counts[key] = (counts[key] or 0) + 1
			end
			for key, c in pairs(counts) do
				lines[#lines + 1] = string.rep("  ", depth + 1) .. key .. " x" .. c
			end
			return
		end
		for _, k in ipairs(kids) do walk(k, depth + 1, maxDepth) end
	end
	for _, s in ipairs(SafeServices()) do
		walk(s, 0, s.ClassName == "Workspace" and CONFIG.TreeWorkspaceDepth or CONFIG.TreeMaxDepth)
	end
	if CONFIG.NilInstances and Caps.getnilinstances then
		lines[#lines + 1] = "<nil instances>"
		pcall(function()
			for _, i in ipairs(Caps.getnilinstances()) do walk(i, 1, 3) end
		end)
	end
	Write("tree.txt", table.concat(lines, "\n"))
	Status("RUNNING | tree.txt (" .. #lines .. " lines)")
end)

local Sources = {}
local ScriptStats = { candidates = 0, decompiled = 0, bytecode = 0 }

local Sig = {}
local SigDirty = false
local function Entry(remote)
	local path = FullName(remote)
	local e = Sig[path]
	if not e then
		e = {
			class = remote.ClassName,
			out = { calls = 0, variants = {}, nvariants = 0 },
			inc = { calls = 0, variants = {}, nvariants = 0 },
			callers = {}, ncallers = 0,
		}
		Sig[path] = e
	end
	return e
end
local function Record(side, remote, method, ...)
	local e = Entry(remote)
	local bucket = e[side]
	bucket.calls += 1
	local sig = TypeSig(...)
	local v = bucket.variants[sig]
	if not v then
		bucket.nvariants += 1
		v = { method = method, count = 0, sample = Sample(...) }
		bucket.variants[sig] = v
	end
	v.count += 1
	SigDirty = true
	return e
end

local HookActive = false
if CONFIG.HookSignatures and Caps.hookmetamethod and Caps.getnamecallmethod and Caps.newcclosure then
	local old
	local ok = pcall(function()
		old = Caps.hookmetamethod(game, "__namecall", Caps.newcclosure(function(self, ...)
			local method = Caps.getnamecallmethod()
			if (method == "FireServer" or method == "InvokeServer")
				and typeof(self) == "Instance" and REMOTE_CLASSES[self.ClassName]
				and not (Caps.checkcaller and Caps.checkcaller()) then
				local callerScript = Caps.getcallingscript and Caps.getcallingscript()
				pcall(function(...)
					local e = Record("out", self, method, ...)
					if Caps.getcallingscript then
						local caller = callerScript and FullName(callerScript) or "?"
						if not e.callers[caller] then e.ncallers += 1 end
						e.callers[caller] = (e.callers[caller] or 0) + 1
					end
				end, ...)
			end
			return old(self, ...)
		end))
	end)
	HookActive = ok
end

local Watched = {}
local function WatchIncoming(r)
	if Watched[r] or not (r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent")) then return end
	Watched[r] = true
	r.OnClientEvent:Connect(function(...)
		Record("inc", r, "OnClientEvent", ...)
	end)
end
if CONFIG.HookSignatures then
	for _, r in ipairs(Remotes) do pcall(WatchIncoming, r) end
end

game.DescendantAdded:Connect(function(d)
	if REMOTE_CLASSES[d.ClassName] and AddRemote(d) then
		Append("remotes_dynamic.txt", Clock() .. " [" .. d.ClassName .. "] " .. FullName(d))
		if CONFIG.HookSignatures then pcall(WatchIncoming, d) end
	end
end)

local function FlushSignatures()
	if not SigDirty then return end
	SigDirty = false
	local paths = {}
	for p in pairs(Sig) do paths[#paths + 1] = p end
	table.sort(paths)
	local lines = {}
	for _, p in ipairs(paths) do
		local e = Sig[p]
		lines[#lines + 1] = p .. " [" .. e.class .. "]"
		for _, side in ipairs({ "out", "inc" }) do
			local b = e[side]
			if b.calls > 0 then
				lines[#lines + 1] = "  " .. (side == "out" and "OUT" or "IN ") .. " calls=" .. b.calls
				for sig, v in pairs(b.variants) do
					local okS, sample = pcall(HttpService.JSONEncode, HttpService, v.sample)
					lines[#lines + 1] = "    (" .. sig .. ") x" .. v.count .. "  sample=" .. (okS and sample or "?")
				end
			end
		end
		for caller, c in pairs(e.callers) do
			lines[#lines + 1] = "  caller: " .. caller .. " x" .. c
		end
	end
	Write("signatures.txt", table.concat(lines, "\n"))
	local okJ, json = pcall(HttpService.JSONEncode, HttpService, Sig)
	if okJ then Write("signatures.json", json) end
end
task.spawn(function()
	while true do
		task.wait(CONFIG.SignatureFlush)
		pcall(FlushSignatures)
	end
end)

