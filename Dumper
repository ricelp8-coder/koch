local function FullName(inst)
	local ok, name = pcall(function() return inst:GetFullName() end)
	return ok and name or tostring(inst)
end

local function Ser(v, depth)
	depth = depth or 0
	local t = typeof(v)
	if t == "nil" then return "nil" end
	if t == "string" then
		if #v > 200 then v = v:sub(1, 200) .. "..." end
		return HttpService:JSONEncode(v)
	end
	if t == "number" or t == "boolean" then return tostring(v) end
	if t == "Instance" then return "<" .. v.ClassName .. "> " .. FullName(v) end
	if t == "buffer" then return "buffer:len=" .. buffer.len(v) end
	if t == "table" then
		if depth >= 2 then return "{...}" end
		local parts, n = {}, 0
		for k, x in pairs(v) do
			n += 1
			if n > 12 then parts[#parts + 1] = "..." break end
			parts[#parts + 1] = "[" .. Ser(k, depth + 1) .. "]=" .. Ser(x, depth + 1)
		end
		return "{" .. table.concat(parts, ", ") .. "}"
	end
	if t == "function" then
		local ok, src, line, name = pcall(debug.info, v, "sln")
		if ok then return "function " .. tostring(name ~= "" and name or "anonymous") .. " @ " .. tostring(src) .. ":" .. tostring(line) end
		return "function"
	end
	return t .. ":" .. tostring(v)
end

local function TypeSig(...)
	local n = select("#", ...)
	if n == 0 then return "()" end
	local out = {}
	for i = 1, n do out[i] = typeof((select(i, ...))) end
	return table.concat(out, ",")
end

local function Sample(...)
	local n = select("#", ...)
	local out = {}
	for i = 1, n do
		local v = select(i, ...)
		local t = typeof(v)
		if t == "string" or t == "number" or t == "boolean" then
			out[i] = v
		else
			out[i] = Ser(v, 1)
		end
	end
	return out
end

local function Yielder(every)
	local count = 0
	return function()
		count += 1
		if count % (every or CONFIG.YieldEvery) == 0 then task.wait() end
	end
end

local function SafeServices()
