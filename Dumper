Phase("scripts", function()
	local seen, list = {}, {}
	local function add(s)
		if typeof(s) ~= "Instance" or seen[s] then return end
		local ok, isScript = pcall(function()
			if s:IsA("LocalScript") or s:IsA("ModuleScript") then return true end
			return s:IsA("Script") and s.RunContext == Enum.RunContext.Client
		end)
		if not (ok and isScript) then return end
		local ok2, path = pcall(FullName, s)
		if ok2 and (path:find("^CoreGui") or path:find("^CorePackages")) then return end
		seen[s] = true
		list[#list + 1] = s
	end
	for _, i in ipairs(Instances) do add(i) end
	if Caps.getscripts then pcall(function() for _, s in ipairs(Caps.getscripts()) do add(s) end end) end
	if Caps.getloadedmodules then pcall(function() for _, s in ipairs(Caps.getloadedmodules()) do add(s) end end) end
	table.sort(list, function(a, b) return FullName(a) < FullName(b) end)
	ScriptStats.candidates = #list

	local used, index = {}, {}
	local function fileName(path, ext)
		local base = Sanitize(path, 110)
		local name, n = base, 1
		while used[name] do
			n += 1
			name = base .. "_" .. n
		end
		used[name] = true
		return name .. ext
	end

	local function decompileWithTimeout(s)
		if not Caps.decompile then return false, "no decompile" end
		local done, ok, res = false, false, nil
		local thread = task.spawn(function()
			ok, res = pcall(Caps.decompile, s)
			done = true
		end)
		local t0 = os.clock()
		while not done and os.clock() - t0 < CONFIG.DecompileTimeout do task.wait() end
		if not done then
			pcall(task.cancel, thread)
			return false, "timeout"
		end
		if ok and type(res) == "string" and #res > 0 then return true, res end
		return false, tostring(res)
	end

	for n, s in ipairs(list) do
		local path = FullName(s)
		local hash = ""
		if Caps.getscripthash then
			local okH, h = pcall(Caps.getscripthash, s)
			if okH and h then hash = " hash=" .. tostring(h) end
		end
		local ok, src = decompileWithTimeout(s)
		if ok then
			local file = fileName(path, ".lua")
			Write("scripts/" .. file, "-- " .. path .. "\n-- " .. s.ClassName .. "\n" .. src)
			Sources[path] = src
			ScriptStats.decompiled += 1
			index[#index + 1] = path .. " -> " .. file .. " [ok]" .. hash
		else
			local saved = false
			if Caps.getscriptbytecode then
				local okB, bc = pcall(Caps.getscriptbytecode, s)
				if okB and type(bc) == "string" and #bc > 0 then
					local file = fileName(path, ".bin")
					Write("bytecode/" .. file, bc)
					ScriptStats.bytecode += 1
					saved = true
					index[#index + 1] = path .. " -> bytecode/" .. file .. " [fail: " .. src .. "]" .. hash
				end
			end
			if not saved then index[#index + 1] = path .. " -> - [fail: " .. src .. "]" .. hash end
		end
		if n % 25 == 0 then
			Status("RUNNING | scripts " .. n .. "/" .. #list)
		end
	end
	Write("scripts/_index.txt", table.concat(index, "\n"))
	Status("RUNNING | scripts done (" .. ScriptStats.decompiled .. " decompiled / " .. ScriptStats.candidates .. ", bytecode " .. ScriptStats.bytecode .. ")")
end)

local ModuleStats = { ok = 0, total = 0 }
Phase("module data", function()
	if not CONFIG.RequireModules then return end
	local function dumpValue(v, depth, seen, indent)
		local t = typeof(v)
		if t ~= "table" then return Ser(v, 2) end
		if seen[v] then return "<cycle>" end
		if depth >= CONFIG.ModuleDepth then return "{...}" end
		seen[v] = true
		local keys = {}
		for k in pairs(v) do keys[#keys + 1] = k end
		table.sort(keys, function(a, b) return tostring(a) < tostring(b) end)
		if #keys == 0 then seen[v] = nil return "{}" end
		local out = { "{" }
		for i, k in ipairs(keys) do
			if i > CONFIG.ModuleMaxKeys then
				out[#out + 1] = indent .. "  -- " .. (#keys - CONFIG.ModuleMaxKeys) .. " more"
				break
			end
			local key = type(k) == "string" and k:match("^[%a_][%w_]*$") and k or ("[" .. Ser(k, 2) .. "]")
			out[#out + 1] = indent .. "  " .. key .. " = " .. dumpValue(v[k], depth + 1, seen, indent .. "  ") .. ","
		end
		out[#out + 1] = indent .. "}"
		seen[v] = nil
		return table.concat(out, "\n")
	end

	local mods = {}
	if Caps.getloadedmodules then
		pcall(function()
			for _, m in ipairs(Caps.getloadedmodules()) do
				if typeof(m) == "Instance" and m:IsA("ModuleScript") then
					local path = FullName(m)
					if not (path:find("^CoreGui") or path:find("^CorePackages")) then mods[#mods + 1] = m end
				end
			end
		end)
	end
	ModuleStats.total = #mods
	local index, used = {}, {}
	local req = Caps.require or require
	local y = Yielder()
	for _, m in ipairs(mods) do
		y()
		local path = FullName(m)
		local ok, data = pcall(req, m)
		if ok then
			local base = Sanitize(path, 110)
			local name, n = base, 1
			while used[name] do n += 1 name = base .. "_" .. n end
			used[name] = true
			local okD, text = pcall(dumpValue, data, 0, {}, "")
			Write("modules/" .. name .. ".lua", "-- " .. path .. " (runtime data)\nreturn " .. (okD and text or ("-- dump failed: " .. tostring(text))))
			index[#index + 1] = path .. " -> " .. name .. ".lua"
			ModuleStats.ok += 1
		else
			index[#index + 1] = path .. " -> - [require failed: " .. tostring(data) .. "]"
		end
	end
	Write("modules/_index.txt", table.concat(index, "\n"))
	Status("RUNNING | module data " .. ModuleStats.ok .. " / " .. ModuleStats.total)
end)


