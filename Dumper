end

local function AllInstances()
	local seen, out = {}, {}
	local function add(i)
		if typeof(i) == "Instance" and not seen[i] then
			seen[i] = true
			out[#out + 1] = i
		end
	end
	for _, s in ipairs(SafeServices()) do
		pcall(function()
			for _, d in ipairs(s:GetDescendants()) do add(d) end
		end)
	end
	if CONFIG.NilInstances and Caps.getnilinstances then
		pcall(function()
			for _, i in ipairs(Caps.getnilinstances()) do
				add(i)
				pcall(function() for _, d in ipairs(i:GetDescendants()) do add(d) end end)
			end
		end)
	end
	return out
end

