local function installHook()
    if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then return false end
    local router = genv.sk_router
    if not router then
        router = {}
        genv.sk_router = router
        local wrap = newcclosure or function(f) return f end
        local oldNC
        local ok = pcall(function()
            oldNC = hookmetamethod(game, "__namecall", wrap(function(self, ...)
                local hub = router.hub
                local kind = hub and hub.mc.rec and hub.remotes[self]
                if kind then
                    local m = getnamecallmethod()
                    if m == "FireServer" or m == "InvokeServer" then
                        pcall(hub.onFire, kind, ...)
                        if setnamecallmethod then pcall(setnamecallmethod, m) end
                    end
                end
                return oldNC(self, ...)
            end))
        end)
        if not ok or not oldNC then
            genv.sk_router = nil
            return false
        end
    end
    local remotes = {}
    for kind, r in pairs({place = R.place, upgrade = R.upgrade, sell = R.sell, target = R.target, skip = R.skip, ability = R.ability}) do
        remotes[r] = kind
    end
    router.hub = {mc = mc, remotes = remotes, onFire = onFire}
    return true
end
local function same(myMatch) return alive() and mc.play and mc.matchId == myMatch end
local function sleep(t, myMatch)
