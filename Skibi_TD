                if ok and type(files) == "table" then
                    for _, f in ipairs(files) do
                        local n = tostring(f):match("([^/\\]+)%.json$")
                        if n then table.insert(names, n) end
                    end
                end
            else
                for n in pairs(mem.items) do table.insert(names, n) end
            end
            table.sort(names)
            return names
        end
        function S.exists(n)
            for _, x in ipairs(S.list()) do
