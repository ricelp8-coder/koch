            total = total + (s.c or TD.price(s.n, 0) or 0)
        elseif s.t == "upgrade" and s.k then
            local to = tonumber(s.lv) or ((lv[s.k] or 0) + 1)
            for l = (lv[s.k] or 0) + 1, to do total = total + (TD.price(s.n, l) or 0) end
            lv[s.k] = to
        end
    end
    return total
end
