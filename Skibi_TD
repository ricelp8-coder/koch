local END = {active = false, sent = 0, nextAt = 0, since = 0, tp = false, tpAt = 0, mode = nil}
local function press(btn)
    if not btn then return false end
    local fired = false
    if type(getconnections) == "function" then
        for _, sig in ipairs({btn.MouseButton1Click, btn.Activated}) do
            pcall(function()
                for _, c in ipairs(getconnections(sig)) do
                    pcall(function() c:Fire() end)
                    fired = true
                end
            end)
        end
    end
    if not fired and type(firesignal) == "function" then
        fired = pcall(firesignal, btn.MouseButton1Click)
    end
    return fired
end
function END.reset()
    END.active, END.sent, END.nextAt, END.tp, END.mode = false, 0, 0, false, nil
end
function END.toLobby()
    if AE.get() then pcall(AE.queue) end
    local g = G.endGui()
    if END.sent <= 2 and g and press(pathOf(g, "Frame/back")) then return end
    pcall(function() TeleportService:Teleport(LOBBY_ID, lp) end)
end
function END.step(action)
    local now = os.clock()
    if not END.active then
        END.active, END.since, END.sent, END.mode = true, now, 0, action
        END.nextAt = now + math.max((action == "Lobby" and cfg.leaveDelay or cfg.replayDelay) or 0, 0.5)
    end
    if END.tp and now - END.tpAt < 25 then return end
    if WH.busy and now - END.since < 10 then return end
    if now < END.nextAt then return end
    local g = G.endGui()
    if END.mode == "Replay" then
        local btn = g and pathOf(g, "Frame/replay")
        if g and btn and not btn.Visible then
            END.mode, END.sent = "Lobby", 0
            flash("Replay is not offered here, going to the lobby", "Warning")
            return
        end
        if END.sent >= 3 then
            END.mode, END.sent = "Lobby", 0
            flash("Replay stalled, going to the lobby", "Warning")
            return
        end
        END.sent = END.sent + 1
        if R.replay then pcall(function() R.replay:FireServer() end) end
        END.nextAt = now + 15
    else
        END.sent = END.sent + 1
        END.toLobby()
        END.nextAt = now + (END.sent >= 3 and 8 or 4)
    end
end
local function init()
    pcall(function()
        lp.OnTeleport:Connect(function(state)
            if not alive() then return end
            if state == Enum.TeleportState.Started or state == Enum.TeleportState.InProgress then
                END.tp, END.tpAt = true, os.clock()
                if AE.get() then pcall(AE.queue) end
            elseif state == Enum.TeleportState.Failed then
                END.tp = false
            end
        end)
    end)
    if IN_LOBBY then
        mc.initDone = true
        local ok, err = pcall(LB.init)
        if not ok then warn("[sk] lobby: " .. tostring(err)) end
        task.delay(3, function()
            if alive() and LB.w.map then LB.w.map:SetOptions(LB.mapOptions()) end
        end)
        return
    end
    local ev = RS:WaitForChild("Event", 30)
    if not (ev and alive()) then
        warn("[sk] match remotes not found")
        return
    end
    R.place = ev:WaitForChild("placeTower", 15)
    R.upgrade = ev:WaitForChild("UpgradeTower", 15)
    R.sell = ev:WaitForChild("RemoveTower", 15)
    R.target = ev:WaitForChild("ChangeTowerTargetMode", 15)
    R.skip = ev:WaitForChild("waveSkip", 15)
    R.replay = ev:FindFirstChild("ReplayCore")
    R.stat = ev:WaitForChild("statUpdate", 15)
    R.ability = pathOf(RS, "TowerScript/spawnTowerAbility")
    R.speed = pathOf(RS, "Game/Speed/Change")
    R.ready = pathOf(RS, "GAME_START/readyButton")
    mc.ok = R.place ~= nil and R.upgrade ~= nil and R.sell ~= nil and R.target ~= nil and R.stat ~= nil
    mc.initDone = true
    if not mc.ok then
        flash("Macro disabled: missing game remotes", "Error")
        if mc.play then
            mc.play = false
            syncToggles()
        end
    end
    mc.hook = type(hookmetamethod) == "function" and type(getnamecallmethod) == "function"
    if R.place then R.place.OnClientEvent:Connect(onPlaceEcho) end
    do
        local tf = G.towersFolder()
        for _, m in ipairs(tf and tf:GetChildren() or {}) do
            local sid = m:GetAttribute("sID")
            if m:GetAttribute("Owner") == lp.Name and type(sid) == "string" then pcall(onPlaceEcho, lp, sid, nil, m.Name) end
        end
    end
    if R.stat then
        R.stat.OnClientEvent:Connect(function(kind, a, b)
            if not alive() then return end
            if kind == "Wave" then
                onWave(a)
            elseif kind == "PlacementLimit" then
                st.placeCur, st.placeMax = tonumber(a), tonumber(b)
            end
        end)
        task.spawn(function()
            local sync = ev:FindFirstChild("requestStatSync")
            if sync then pcall(function() sync:FireServer() end) end
        end)
    end
    if R.skip then
        R.skip.OnClientEvent:Connect(function(_, open)
            st.skipOpen = open == true
            if st.skipOpen then st.skipAt = os.clock() + 0.15 end
        end)
    end
    local note = RS:FindFirstChild("Notification")
    if note and note:IsA("BindableEvent") then note.Event:Connect(onNotify) end
    lp:GetAttributeChangedSignal("Cash"):Connect(function()
        if alive() and mc.rec then noteMoney() end
    end)
    local endedVal = RS:FindFirstChild("ended")
    if endedVal then
        endedVal.Changed:Connect(function()
            if alive() and endedVal.Value == false and mc.finalSeen then newMatch() end
        end)
    end
    task.spawn(function()
        local lastReady = -100
        while alive() do
            task.wait(0.5)
            if cfg.autoStart and R.ready and not G.started() and not G.ended() and os.clock() - lastReady >= 3 then
                lastReady = os.clock()
                pcall(function() R.ready:FireServer(true) end)
            end
        end
    end)
    task.spawn(function()
        local n = 0
        while alive() do
            task.wait(0.1)
            n = n + 1
            pcall(tickStamps)
            if cfg.autoSkip and R.skip and st.skipOpen and not mc.finalSeen and os.clock() >= st.skipAt then
                if isBarrier(mc.wave) then
                    if st.limWave ~= mc.wave then
                        st.limWave = mc.wave
                        flash("Auto Skip paused: barrier on wave " .. mc.wave, "Warning")
                    end
                else
                    st.skipAt = os.clock() + 2
                    pcall(function() R.skip:FireServer(true) end)
                end
            end
            if G.endGui() or G.ended() then
                matchEnded()
                if cfg.endAction ~= "None" and G.endGui() then
                    local ok, err = pcall(END.step, cfg.endAction)
                    if not ok then warn("[sk] endAction: " .. tostring(err)) end
                end
            elseif END.active then
                END.reset()
            end
            ensureSpeed()
            if mc.ok and mc.play and not mc.running and #mc.steps > 0 and mc.selected
                and mc.ranMatch ~= mc.matchId and not mc.finalSeen and G.started() and not G.ended() then
                local gateRes = mapGate()
                if gateRes == "go" then
                    mc.ranMatch = mc.matchId
                    mc.running = true
                    local myMatch = mc.matchId
                    task.spawn(function()
                        local ok, err = pcall(runPlayback, myMatch)
                        if not ok then
                            flash("Macro error: " .. tostring(err):sub(1, 60), "Error")
                            warn("[sk] macro: " .. tostring(err))
                        end
                        mc.playing = false
                        mc.running = false
                    end)
                end
            end
            if n % 5 == 0 and macroStatus then
                local line
                if mc.running then
                    line = string.format("PLAYING %d/%d", mc.stepNo, #mc.steps)
                elseif mc.play then
                    line = "ARMED (waits for a match)"
                elseif mc.rec then
                    line = "RECORDING"
                end
                macroStatus:SetText(string.format("steps <b>%d</b> | wave <b>%d</b> | $<b>%s</b>%s",
                    #mc.steps, mc.wave, fmtMoney(G.money()), line and ("\n" .. line) or ""))
            end
        end
    end)
end
