local LB = {groups = {"ChapterServers", "EventServers", "Event2Servers", "EpisodeServers", "MultiverseServers", "EndlessServers"},
    next = 0, teleporting = false, tpAt = 0, w = {}}
function LB.maps()
    local out, seen = {}, {}
    local done = lp:FindFirstChild("completedChapters")
    for _, g in ipairs(LB.groups) do
        local mod = RS:FindFirstChild(g)
        local ok, list = pcall(function() return mod and require(mod) end)
        if ok and type(list) == "table" then
            local rows = {}
            for _, e in pairs(list) do
                if type(e) == "table" and type(e.Core) == "string" and not seen[e.Core] then
                    local locked = e.Requires ~= nil and not (done and done:FindFirstChild(tostring(e.Requires)))
                    if not locked then rows[#rows + 1] = e.Core end
                end
            end
            table.sort(rows, function(a, b)
                local na, nb = tonumber(a:match("([%d%.]+)%s*$")), tonumber(b:match("([%d%.]+)%s*$"))
                if na and nb and a:gsub("[%d%.]+%s*$", "") == b:gsub("[%d%.]+%s*$", "") then return na < nb end
                return a < b
            end)
            for _, c in ipairs(rows) do
                seen[c] = true
                out[#out + 1] = c
            end
        end
    end
    return out
end
function LB.mapOptions()
    local list = IN_LOBBY and LB.maps() or {}
    local sel = cfg.joinMap
    if sel ~= "" and not table.find(list, sel) then table.insert(list, 1, sel) end
    if #list == 0 then list = {"(open in the lobby)"} end
    return list
end
function LB.myServer()
    local root = RS:FindFirstChild("Servers")
    if not root then return nil end
    for _, core in ipairs(root:GetChildren()) do
        for _, sv in ipairs(core:GetChildren()) do
            local con = sv:FindFirstChild("Connected")
            if con then
                for _, v in ipairs(con:GetChildren()) do
                    if v:IsA("ValueBase") and tonumber(v.Value) == lp.UserId then return sv, core.Name end
                end
            end
        end
    end
    return nil
end
function LB.step()
    local ev = RS:FindFirstChild("Events")
    if not ev then return 3 end
    if LB.teleporting and os.clock() - LB.tpAt < 25 then return 2 end
    LB.teleporting = false
    local core = cfg.joinMap
    if core == "" or core == "(open in the lobby)" then return 3 end
    local sv, cur = LB.myServer()
    if sv and cur ~= core then
        local del = ev:FindFirstChild("deleteServer")
        if del then pcall(function() del:FireServer() end) end
        return 2
    end
    if not sv then
        local cs = ev:FindFirstChild("createServer")
        if cs then pcall(function() cs:InvokeServer(core) end) end
        return 1.5
    end
    local start = ev:FindFirstChild("start")
    if start then
        if AE.get() then pcall(AE.queue) end
        pcall(function() start:FireServer(cfg.joinMode == "Matchmaking") end)
    end
    return 6
end
function LB.init()
    local ev = RS:WaitForChild("Events", 20)
    if not ev then return end
    task.spawn(function()
        local ts = ev:WaitForChild("teleportingSequence", 10)
        if ts then
            ts.OnClientEvent:Connect(function()
                LB.teleporting, LB.tpAt = true, os.clock()
                if AE.get() then pcall(AE.queue) end
            end)
        end
    end)
    task.spawn(function()
        while alive() do
            task.wait(0.5)
            if cfg.autoJoin and os.clock() >= LB.next then
                local ok, d = pcall(LB.step)
                LB.next = os.clock() + ((ok and d) or 3)
            end
        end
    end)
    task.spawn(function()
        local last = -100
        while alive() do
            task.wait(1)
            if cfg.autoClaimPass and os.clock() - last >= 30 then
                last = os.clock()
                local bp = RS:FindFirstChild("BattlepassUpdate")
                if bp then pcall(function() bp:FireServer("ClaimAll", "ClaimAll") end) end
            end
        end
    end)
end
