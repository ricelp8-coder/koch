local PRIV = {
    nameOrig = setmetatable({}, {__mode = "k"}), nameWatched = setmetatable({}, {__mode = "k"}), nameConns = {},
    userSaved = {}, userGen = 0, fpsOrig = setmetatable({}, {__mode = "k"}), conns = {},
