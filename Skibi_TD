function MX.place(s, myMatch)
    local p = a2v(s.p)
    local have = idAt(p, s.n, mc.claim)
    if have then
        mc.claim[have] = true
        return true, have
    end
    local key = "P#" .. tostring(s.n)
    local attempts = 0
    while same(myMatch) do
        local there
        local need = 0
        local ready = waitUntil(function()
            there = idAt(p, s.n, mc.claim)
            if there then return true end
            need = MX.need(key, s, TD.price(s.n, 0))
            if MX.cash() < need or slotsFull() then return false end
            return os.clock() >= (mc.nextAt or 0)
        end, math.huge, myMatch, 0.03)
        if not ready then return false end
        if there then
            mc.claim[there] = true
            return true, there
        end
        local cf = CFrame.new(p)
        if type(s.cf) == "table" and #s.cf == 12 then
            local okc, v = pcall(function() return CFrame.new(table.unpack(s.cf)) end)
            if okc and typeof(v) == "CFrame" then cf = v end
        end
        local before = G.money()
        mc.waitPlace, mc.waitName, mc.waitPlaceId, mc.placeFail = p, s.n, nil, nil
        R.place:FireServer(s.n, cf, false)
        mc.nextAt = os.clock() + 0.4
        MX.reserve(before, need)
        attempts = attempts + 1
        waitUntil(function()
            return mc.waitPlaceId ~= nil or mc.placeFail ~= nil
        end, ackWindow(), myMatch, 0.03)
        local nid, fail = mc.waitPlaceId, mc.placeFail
        if nid and not mc.id2pos[nid] then
            waitUntil(function() return mc.id2pos[nid] ~= nil end, 5, myMatch, 0.03)
        end
        mc.waitPlace, mc.waitName, mc.waitPlaceId = nil, nil, nil
        if nid and mc.id2pos[nid] then
            mc.claim[nid] = true
            return true, nid
        end
        if not same(myMatch) then return false end
        mc.spend = nil
        if fail == "limit" then
            flash(tostring(s.n) .. ": placement limit reached, step skipped", "Warning")
            return false
        elseif fail == "money" then
            MX.raise(key, need)
            if not sleep(0.4, myMatch) then return false end
        elseif attempts >= 5 then
            flash(tostring(s.n) .. ": place failed (not in hotbar or blocked spot), step skipped", "Warning")
            return false
        elseif not sleep(0.6, myMatch) then
            return false
        end
    end
    return false
end
function MX.upgrade(s, myMatch)
    local id = stepId(s)
    if not id then return false end
    local want = tonumber(s.lv) or ((mc.id2lvl[id] or 0) + 1)
    local misses = 0
    while same(myMatch) do
        if not mc.id2pos[id] then return false end
        local name = mc.id2name[id]
        local level = mc.id2lvl[id] or 0
        if level >= want then return true end
        local maxL = TD.maxLevel(name)
        if maxL and level >= maxL then return true end
        local key = "U#" .. tostring(name) .. "#" .. (level + 1)
        local est = TD.upgradeCost(id, level + 1)
        local need = 0
        local ready = waitUntil(function()
            if not mc.id2pos[id] or (mc.id2lvl[id] or 0) >= want then return true end
            need = MX.need(key, (level + 1 == want) and s or {}, est)
            if MX.cash() < need then return false end
            return os.clock() >= (mc.nextAt or 0)
        end, math.huge, myMatch, 0.03)
        if not ready then return false end
        if not mc.id2pos[id] then return false end
        level = mc.id2lvl[id] or 0
        if level >= want then return true end
        local before = G.money()
        local sentAt = os.clock()
        R.upgrade:FireServer(id)
        mc.nextAt = sentAt + 0.3
        MX.reserve(before, need)
        waitUntil(function()
            return (mc.id2lvl[id] or 0) > level or not mc.id2pos[id] or (mc.upFailAt or 0) >= sentAt
        end, ackWindow(), myMatch, 0.03)
        if not same(myMatch) then return false end
        if (mc.id2lvl[id] or 0) > level then
            misses = 0
        elseif not mc.id2pos[id] then
            return false
        elseif (mc.upFailAt or 0) >= sentAt then
            mc.spend = nil
            MX.raise(key, need)
