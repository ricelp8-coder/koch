local function mapGate()
    if not mc.map then return "go" end
    local cur = G.chapter()
    if cur then
        if normMap(cur) == normMap(mc.map) then return "go" end
        mc.ranMatch = mc.matchId
        flash("Macro skipped: recorded on " .. mc.map .. ", this is " .. cur, "Warning")
        return "block"
    end
    if mc.mapWaitMatch ~= mc.matchId then mc.mapWaitMatch, mc.mapWaitAt = mc.matchId, os.clock() end
    if os.clock() - mc.mapWaitAt < 10 then return "wait" end
