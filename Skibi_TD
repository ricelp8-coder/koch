local function gate(s, myMatch)
    local mode = mc.replay
    local timed = mode == "Time"
    if s.t == "skip" and mode == "Money" then return false end
    if timed and (s.w or 0) <= 0 and s.rt and mc.playT0 then
        local due = math.max(0, s.rt - (mc.playRt0 or 0))
        if not waitUntil(function() return mc.wave >= 1 or os.clock() - mc.playT0 >= due end, math.huge, myMatch) then
            return false
        end
    end
    local strict = s.t == "sell" or s.t == "skip" or s.t == "ability"
    if strict or timed or mode == "Hybrid" then
        local w = s.w or 0
        if w > 0 then
            if not waitUntil(function() return mc.wave >= w end, math.huge, myMatch) then return false end
            if strict or timed then
                if s.gt then
                    if not waitUntil(function()
                        return mc.wave > w or (st.waveClock ~= nil and G.clock() - st.waveClock >= s.gt)
                    end, math.huge, myMatch) then return false end
                elseif s.wt then
                    local due = math.min(s.wt, 900)
                    if not waitUntil(function()
                        return mc.wave > w or (st.waveStart ~= nil and os.clock() - st.waveStart >= due)
                    end, math.huge, myMatch) then return false end
                end
            end
        end
    end
    return same(myMatch)
end
local function runPlayback(myMatch)
    mc.playing = true
    mc.stepNo = 0
    mc.claim, mc.k2id = {}, {}
    mc.spend, mc.nextAt, mc.upFailAt = nil, nil, nil
    local sel, steps = mc.selected, mc.steps
    mc.playT0 = os.clock()
    mc.playRt0 = nil
    for _, s0 in ipairs(steps) do
        if s0.rt then mc.playRt0 = s0.rt break end
    end
    for i, s in ipairs(steps) do
        if not same(myMatch) then break end
        mc.stepNo = i
        if gate(s, myMatch) then
            if s.t == "place" then
                local ok, id = MX.place(s, myMatch)
                if ok and id and s.k then mc.k2id[s.k] = id end
            elseif s.t == "upgrade" then
                MX.upgrade(s, myMatch)
            elseif s.t == "sell" then
                MX.sell(s, myMatch)
            elseif s.t == "target" then
                MX.target(s, myMatch)
            elseif s.t == "skip" then
                MX.skip(s, myMatch)
            elseif s.t == "ability" then
                MX.ability(s, myMatch)
            end
            task.wait()
        end
    end
    local finished = same(myMatch) and mc.stepNo >= #steps
    mc.playing = false
    if finished then flash("Macro finished, waiting for the next match", "Success") end
    if sel and sel == mc.selected and steps == mc.steps then
        local changed = false
        for _, s in ipairs(steps) do
            local key = s.t == "place" and ("P#" .. tostring(s.n)) or nil
            if key and mc.book[key] and (not s.c or mc.book[key] > s.c) then
                s.c = mc.book[key]
                changed = true
            end
        end
        if changed and MAC.write(sel, {v = 1, replay = mc.replay, map = mc.map, steps = steps}) then
            flash("Macro calibrated: prices saved", "Success")
        end
    end
end
local function assignKeys(steps)
