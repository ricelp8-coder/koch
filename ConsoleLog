		toast("saved to workspace/" .. FILE)
	else
		toast("writefile not supported")
	end
end)

local rows = {}
local function render()
	local shown = visibleEntries()
	local from = math.max(1, #shown - MAX_SHOWN + 1)
	local n = 0
	for i = from, #shown do
		n = n + 1
		local e = shown[i]
		local row = rows[n]
		if not row then
			row = Instance.new("TextBox")
			row.BackgroundTransparency = 1
			row.Size = UDim2.new(1, 0, 0, 0)
			row.AutomaticSize = Enum.AutomaticSize.Y
			row.TextWrapped = true
			row.TextEditable = false
			row.ClearTextOnFocus = false
			row.Font = Enum.Font.Code
			row.TextSize = 12
			row.TextXAlignment = Enum.TextXAlignment.Left
			row.TextYAlignment = Enum.TextYAlignment.Top
			row.Parent = list
			rows[n] = row
		end
		row.LayoutOrder = n
		row.Text = string.format("%s [%s] %s", e.Time, TAGS[e.Kind] or "?", e.Text)
		row.TextColor3 = COLORS[e.Kind] or TEXT
		row.Visible = true
	end
	for i = n + 1, #rows do rows[i].Visible = false end
	task.defer(function()
		list.CanvasPosition = Vector2.new(0, math.max(0, list.AbsoluteCanvasSize.Y - list.AbsoluteWindowSize.Y))
	end)
end

local alive = true
function State.Destroy()
	alive = false
	pcall(function() conn:Disconnect() end)
	pcall(function() gui:Destroy() end)
end
closeBtn.Activated:Connect(State.Destroy)

task.spawn(function()
	while alive do
		if State.Dirty then
			State.Dirty = false
			pcall(render)
		end
		task.wait(0.3)
	end
end)
State.Dirty = true
