local MAX_STORED = 600
local MAX_SHOWN = 150
local FILE = "DiamondHub_ConsoleLog.txt"

local State = { Entries = {}, Dirty = false, Filter = "", OnlyHub = true, ShowInfo = true, Paused = false }
env.__ConsoleLog = State

local NAVY = Color3.fromHex("0d1228")
local ACCENT = Color3.fromHex("3d6bff")
local OUTLINE = Color3.fromHex("1b2554")
local TEXT = Color3.fromHex("eef2ff")
local COLORS = {
	[Enum.MessageType.MessageOutput] = Color3.fromHex("eef2ff"),
	[Enum.MessageType.MessageInfo] = Color3.fromHex("8fb3ff"),
	[Enum.MessageType.MessageWarning] = Color3.fromHex("ffc857"),
	[Enum.MessageType.MessageError] = Color3.fromHex("ff6b6b"),
}
local TAGS = {
	[Enum.MessageType.MessageOutput] = "OUT",
	[Enum.MessageType.MessageInfo] = "INF",
	[Enum.MessageType.MessageWarning] = "WRN",
	[Enum.MessageType.MessageError] = "ERR",
}

local function isHub(msg)
	return msg:find("[ld]", 1, true) or msg:find("[sd]", 1, true) or msg:find("[DiamondHub]", 1, true)
		or msg:find("DiamondHub", 1, true)
end

local function push(msg, kind, stamp)
	if State.Paused then return end
	msg = tostring(msg)
	table.insert(State.Entries, { Text = msg, Kind = kind, Time = stamp or os.date("%H:%M:%S") })
	while #State.Entries > MAX_STORED do table.remove(State.Entries, 1) end
	State.Dirty = true
end

pcall(function()
	for _, h in ipairs(LogService:GetLogHistory()) do
		local t = tonumber(h.timestamp)
		push(h.message, h.messageType, t and os.date("%H:%M:%S", t) or "--:--:--")
	end
end)
local conn = LogService.MessageOut:Connect(function(msg, kind) push(msg, kind) end)

local function visibleEntries()
	local out = {}
	local f = State.Filter:lower()
	for _, e in ipairs(State.Entries) do
		local ok = true
		if State.OnlyHub and not isHub(e.Text) then ok = false end
		if ok and not State.ShowInfo and (e.Kind == Enum.MessageType.MessageOutput or e.Kind == Enum.MessageType.MessageInfo) then ok = false end
		if ok and f ~= "" and not e.Text:lower():find(f, 1, true) then ok = false end
		if ok then out[#out + 1] = e end
	end
	return out
end

local function asText(list)
	local lines = {}
	for _, e in ipairs(list) do
		lines[#lines + 1] = string.format("%s [%s] %s", e.Time, TAGS[e.Kind] or "?", e.Text)
	end
	return table.concat(lines, "\n")
end

