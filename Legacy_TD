end
function MX.awayWait(m, myMatch)
    return waitUntil(function()
        local e = mc.reg[m]
        return not (e and e.away)
    end, 30, myMatch, 0.1)
end
function MX.upgrade(s, myMatch)
    local want = tonumber(s.lv)
    local misses, moneyFails = 0, 0
    while same(myMatch) do
        local m = MX.findWait(s, myMatch)
        if not m then return false end
        if not MX.awayWait(m, myMatch) then return false end
        local level = TW.level(m)
        if want and level >= want then return true end
        local maxL = TW.maxLevel(s.n or m.Name)
        if maxL and level >= maxL then return true end
        local margin = 1 + 0.03 * math.min(moneyFails, 10)
        local price = TW.upPrice(m.Name, level) or s.c or 0
        local ready = waitUntil(function()
            local m2 = MX.find(s)
            if not m2 then return false end
            local l2 = TW.level(m2)
            if want and l2 >= want then return true end
            if MX.cash() < (TW.upPrice(m2.Name, l2) or price) * margin then return false end
            return os.clock() >= mc.nextAt
        end, math.huge, myMatch, 0.05)
        if not ready then return false end
        m = MX.findWait(s, myMatch)
        if not m then return false end
        level = TW.level(m)
        if want and level >= want then return true end
        price = TW.upPrice(m.Name, level) or price
        local before = money()
        FW.fire("UpgradeTroop", m)
        MX.touch(0.35)
        local up = waitUntil(function()
            local m3 = MX.find(s)
            return m3 ~= nil and TW.level(m3) > level
        end, 3, myMatch, 0.03)
        if up then
            MX.reserve(before, price)
            misses, moneyFails = 0, 0
        else
            mc.spend = nil
            if money() < price then
                moneyFails = moneyFails + 1
                if not sleep(0.35 + 0.15 * math.min(moneyFails, 8), myMatch) then return false end
            else
                misses = misses + 1
                if misses >= 4 then
                    flash("Upgrade rejected, step skipped", "Warning")
                    return false
                end
                if not sleep(0.5, myMatch) then return false end
            end
        end
    end
    return false
end
function MX.sell(s, myMatch)
    for _ = 1, 4 do
        local m = MX.findWait(s, myMatch, 2)
        if not m then return true end
        if not MX.awayWait(m, myMatch) then return false end
        FW.fire("SellTroop", m)
        MX.touch(0.3)
        if waitUntil(function() return MX.find(s) == nil end, 3, myMatch, 0.03) then return true end
        if not same(myMatch) then return false end
        if not sleep(0.4, myMatch) then return false end
    end
    return false
end
function MX.target(s, myMatch)
    local fails = 0
    for _ = 1, 12 do
        if not same(myMatch) then return false end
        local m = MX.findWait(s, myMatch)
        if not m then return false end
        local cur = TW.target(m)
        if cur == s.mode or cur == nil then return cur == s.mode end
        if not MX.cadence(myMatch) then return false end
        FW.fire("ChangeTargetting", m)
        MX.touch(0.3)
        local moved = waitUntil(function()
            local m2 = MX.find(s)
            return m2 == nil or TW.target(m2) ~= cur
        end, 2, myMatch, 0.04)
        if not moved then
            fails = fails + 1
            if fails >= 3 then return false end
        end
    end
    local m = MX.find(s)
    return m ~= nil and TW.target(m) == s.mode
end
function MX.act(s, myMatch)
    if not s.ev then return false end
    local m = MX.findWait(s, myMatch)
    if not m then return false end
    if TOWER_BTN[s.ev] then FW.fire(s.ev, m) end
