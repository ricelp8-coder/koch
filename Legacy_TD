function GU.sellBtn() return path(pg, "Lobby/UnitFrame/Buttons/SellUnits/Button") end
function GU.invMode()
    local b = GU.sellBtn()
    if not b then return nil end
    return tostring(b.Text) == "Sell Units" and "Normal" or "Sell"
end
function GU.leaveSell()
    if GU.invMode() ~= "Sell" then return true end
    GU.pressAsync(GU.sellBtn())
    GU.big({"NoButton"}, 0.6)
    local t0 = os.clock()
    while GU.invMode() == "Sell" and os.clock() - t0 < 1 do task.wait(0.05) end
    return GU.invMode() ~= "Sell"
end
function GU.openCrate(uid, amount)
    if not GU.leaveSell() then return false end
    local b = GU.invItem(uid)
    if not b then return false end
    GU.pressAsync(b)
    local names = amount == 10 and {"Button3", "YesButton"} or {"YesButton", "Button1"}
    return (GU.big(names, 3))
end
function GU.sellUnits(ids)
    local btn = GU.sellBtn()
    if not btn then return false end
    if GU.invMode() ~= "Sell" then
        GU.press(btn)
        task.wait(0.15)
    end
    if GU.invMode() ~= "Sell" then return false end
    local picked = {}
    for _, uid in ipairs(ids) do
        local b = GU.invItem(uid)
        local icon = b and b.Parent and b.Parent:FindFirstChild("BulkSellIcon")
        if b and icon and not icon.Visible then
            -- a locked unit answers with a popup that yields the handler: never press it on this thread
            GU.pressAsync(b)
            task.wait(0.05)
            GU.dismiss()
        end
        if icon and icon.Visible then picked[#picked + 1] = uid end
    end
    if #picked == 0 then
        GU.leaveSell()
        return false
    end
    GU.pressAsync(btn)
    if not GU.big({"YesButton"}, 3) then
        GU.leaveSell()
        return false
    end
    return picked
end
function GU.claimQuest(kind, id)
    local b = path(pg, "Lobby/QuestsFrame/QuestMainFrame/MainFrame/AllQuests/" .. tostring(kind) .. "/" .. tostring(id) .. "/Progress/ClaimButton")
    return GU.press(b)
end
function GU.route(ev, a, ...)
    if ev == "Summon1" or ev == "Summon10" then
        return GU.press(path(pg, "Lobby/SummonShopFrame/SummonMenu/RightMenu/BuyButtons/" .. ev))
    end
    if ev == "StartTeleport" then return GU.press(path(pg, "Lobby/QueueFrame/Start")) end
    if ev == "ClaimQuestReward" then return GU.claimQuest(a, (...)) end
    if ev == "Open1Crate" or ev == "Open10Crate" then return GU.openCrate(a, ev == "Open10Crate" and 10 or 1) end
    if ev == "SellTroops" then return GU.sellUnits(type(a) == "table" and a or {}) end
    if ev == "VoteMap" then return GU.vote(a) end
    if ev == "VoteSkipWave" then return GU.skip() end
    if TOWER_BTN[ev] then return GU.tower(ev, a) end
    if ev == "TeleportToLobby" then return GU.toLobby() end
    if ev == "PlayMatchAgain" then return GU.playAgain() end
    return nil
end
function FW.fire(ev, ...)
    local r = GU.route(ev, ...)
    if r ~= nil then return r end
    -- no button for this request: never send it ourselves
    warn("[ld] no game button for " .. tostring(ev) .. ", skipped")
    return false
end

