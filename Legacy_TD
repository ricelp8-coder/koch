end
function MX.skip(s, myMatch)
    if not same(myMatch) then return end
    local w = s.w or 0
    if w > 0 and mc.wave > w then return end
    if cfg.autoSkip and not isBarrier(mc.wave) then return end
    if not MT.skipAvailable() then
        waitUntil(MT.skipAvailable, 20, myMatch, 0.05)
    end
    if not same(myMatch) or not MT.skipAvailable() or MT.skipVoted() then return end
    MT.fireSkip()
    MX.touch(0.3)
end
local function gate(s, myMatch)
    local mode = mc.replay
    local timed = mode == "Time"
    local hybrid = mode == "Hybrid"
    if s.t == "skip" and mode == "Money" then return false end
    if timed and (s.w or 0) <= 0 and s.rt and mc.playT0 then
        local due = math.max(0, s.rt - (mc.playRt0 or 0))
        if not waitUntil(function() return mc.wave >= 1 or os.clock() - mc.playT0 >= due end, math.huge, myMatch) then
            return false
        end
    end
    if s.t == "sell" or s.t == "skip" or s.t == "act" or timed or hybrid then
        local w = s.w or 0
        if w > 0 then
            if not waitUntil(function() return mc.wave >= w end, math.huge, myMatch) then return false end
            if (s.t == "sell" or s.t == "skip" or s.t == "act" or timed) and s.wt then
                local due = math.min(s.wt, 900)
                local reached = waitUntil(function()
                    return mc.wave > w or (st.waveStart ~= nil and os.clock() - st.waveStart >= due)
                end, math.huge, myMatch)
                if not reached then return false end
            end
        end
    end
    return same(myMatch)
end
local function runPlayback(myMatch)
    mc.playing = true
    mc.stepNo = 0
    mc.claim = setmetatable({}, {__mode = "k"})
    mc.k2pos = {}
    mc.spend, mc.nextAt = nil, 0
    mc.warnedHotbar = {}
    local steps = mc.steps
    local tData = os.clock()
    while same(myMatch) and not FW.data() and os.clock() - tData < 15 do task.wait(0.2) end
    mc.playT0 = os.clock()
    mc.playRt0 = nil
    for _, s0 in ipairs(steps) do
        if s0.rt then mc.playRt0 = s0.rt break end
    end
    do
        local data = FW.data()
        local eq = {}
        for _, id in pairs(data and type(data.EquippedTroops) == "table" and data.EquippedTroops or {}) do eq[id] = true end
        local seen, missing = {}, {}
        for _, s0 in ipairs(steps) do
            if s0.t == "place" and s0.n and not seen[s0.n] then
                seen[s0.n] = true
                if data and not eq[s0.n] then missing[#missing + 1] = tostring(s0.n) end
            end
        end
        if #missing > 0 then flash("Not in your loadout: " .. table.concat(missing, ", "), "Warning") end
    end
    for i, s in ipairs(steps) do
        if not same(myMatch) then break end
        mc.stepNo = i
        if gate(s, myMatch) then
            if s.t == "place" then
                MX.place(s, myMatch)
            elseif s.t == "upgrade" then
                MX.upgrade(s, myMatch)
            elseif s.t == "sell" then
                MX.sell(s, myMatch)
            elseif s.t == "target" then
                MX.target(s, myMatch)
            elseif s.t == "skip" then
                MX.skip(s, myMatch)
            elseif s.t == "act" then
                MX.act(s, myMatch)
            end
            task.wait()
        end
    end
    local finished = same(myMatch) and mc.stepNo >= #steps
    mc.playing = false
    if finished then flash("Macro finished, waiting for the next match", "Success") end
end
local function assignKeys(steps)
    local alive_, lv, n = {}, {}, 0
    for _, s in ipairs(steps) do
        local p = a2v(s.p)
        if s.t == "skip" then
        elseif s.t == "place" then
            n = n + 1
            s.k = s.k or ("L" .. n)
            alive_[s.k] = {pos = p, name = s.n}
            lv[s.k] = 1
        else
            if not s.k then
                local best, bestD
                for k, a in pairs(alive_) do
                    local d = xzDist(a.pos, p)
                    if d < 1.0 and (not bestD or d < bestD) then best, bestD = k, d end
                end
                s.k = best
            end
            if s.k then
                if s.t == "upgrade" then
                    if s.lv then
                        lv[s.k] = s.lv
                    else
                        lv[s.k] = (lv[s.k] or 1) + 1
                        s.lv = lv[s.k]
                    end
                elseif s.t == "sell" then
                    alive_[s.k] = nil
                end
            end
        end
    end
end
local function cleanSteps(arr)
    local out = {}
    if type(arr) ~= "table" then return out end
    for _, s in ipairs(arr) do
        if type(s) == "table" and type(s.t) == "string" and type(s.p) == "table"
            and type(s.p[1]) == "number" and type(s.p[2]) == "number" and type(s.p[3]) == "number" then
            table.insert(out, s)
        end
    end
    return out
end
local function macroPlan(steps)
    local total, unknown, towers = 0, 0, {}
    for _, s in ipairs(steps) do
        if s.t == "place" then
            towers[s.k or ""] = {name = s.n, level = 1}
            local pr = s.n and TW.placePrice(s.n)
            if pr then total = total + pr else unknown = unknown + 1 end
        elseif s.t == "upgrade" then
            local tw = towers[s.k or ""]
            if tw then
                local pr = TW.priceAt(tw.name, tw.level + 1)
                if pr then total = total + pr else unknown = unknown + 1 end
                tw.level = tw.level + 1
            else
                unknown = unknown + 1
            end
        elseif s.t == "sell" then
            towers[s.k or ""] = nil
        end
    end
    return total, unknown
end
local function refreshMacroList()
    if macroDD then macroDD:SetOptions(MAC.list()) end
end
local function loadMacro(name, silent)
    local d = MAC.read(name)
    local steps = d and cleanSteps(d.steps) or {}
    if #steps == 0 then
        if not silent then flash("Macro not found or empty: " .. tostring(name), "Error") end
        return false
    end
    assignKeys(steps)
    mc.steps = steps
    mc.map = (type(d.map) == "string" and d.map ~= "") and d.map or nil
    mc.selected = name
    MAC.setAuto(name)
    if macroDD then macroDD:Set(name, true) end
    if nameInput then nameInput:Set(name, true) end
    if not silent then
        local total = macroPlan(steps)
        if total > 0 then
            flash("Loaded macro: " .. name .. " (" .. #steps .. " steps, about $" .. fmtMoney(total) .. ")", "Success")
        else
            flash("Loaded macro: " .. name .. " (" .. #steps .. " steps)", "Success")
        end
    end
    return true
end
local function saveMacro()
    local n = sanitize(nameInput:Get())
    if n == "" then
        flash("Enter a macro name first", "Warning")
        return
    end
    if mc.rec then
        -- saving ends the recording, otherwise later actions would keep landing in a macro that is already saved
        mc.rec = false
        MT.clearStamps()
        syncToggles()
    end
    if #mc.steps == 0 then
        flash("Nothing to save: record a macro first", "Warning")
        return
    end
    if MAC.write(n, {v = 2, replay = mc.replay, map = mc.map or currentMap(), steps = mc.steps}) then
        mc.selected = n
        MAC.setAuto(n)
        refreshMacroList()
        macroDD:Set(n, true)
        flash("Saved macro: " .. n .. " (" .. #mc.steps .. " steps)", "Success")
    else
        flash("Save failed", "Error")
    end
end
local function deleteMacro()
    local n = sanitize(nameInput:Get())
    if n == "" then n = mc.selected or "" end
    if n == "" or not MAC.exists(n) then
        flash("Pick a saved macro to delete", "Warning")
