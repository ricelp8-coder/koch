            end, 3.5, myMatch, 0.03)
        end
        if nm then
            if NET.viaNet and not NET.way then
                NET.way = NET.cur
                warn("[ld] net place works with variant " .. NET.cur)
                flash("Remote placement works (variant " .. NET.cur .. ")", "Success")
            end
            mc.claim[nm] = true
            MX.reserve(before, price)
            local live = TW.pos(nm) or ne.pos
            if s.k then mc.k2pos[s.k] = live end
            if xzDist(live, p) > 3 then
                warn(string.format("[ld] %s placed at %.1f,%.1f,%.1f but the recorded position is %.1f,%.1f,%.1f",
                    tostring(s.n), live.X, live.Y, live.Z, p.X, p.Y, p.Z))
