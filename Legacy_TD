-- lobby: the same idea, the game's own buttons and its own confirmation popup
function GU.big(names, timeout)
    local frame = path(pg, "MainFrames/NotificationFrame")
    local t0 = os.clock()
    while os.clock() - t0 < (timeout or 3) do
        if frame and frame.Visible then
            for _, n in ipairs(names) do
                local b = path(frame, "BigNotification/Buttons/" .. n)
                if b and b.Visible and b:FindFirstChild("Btn") then return GU.press(b.Btn), n end
            end
        end
        task.wait(0.05)
    end
    return false
end
function GU.dismiss()
    local frame = path(pg, "MainFrames/NotificationFrame")
    if frame and frame.Visible then GU.big({"OkButton", "NoButton", "Button2"}, 0.2) end
end
function GU.pressAsync(btn)
    task.spawn(function() pcall(GU.press, btn) end)
end
function GU.invItem(uid)
    local list = path(pg, "Lobby/UnitFrame/UnitList")
    local f = list and list:FindFirstChild(tostring(uid), true)
    return f and f:FindFirstChild("InteractiveButton", true)
