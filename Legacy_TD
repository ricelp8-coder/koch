    local mx, my = x + (x - l1.X) / gx, y + (y - l1.Y) / gy
    local l3 = GU.readMouse(mx, my)
    GU.diag.mx, GU.diag.my, GU.diag.l3 = mx, my, l3
    if l3 and math.abs(l3.X - x) <= 3 and math.abs(l3.Y - y) <= 3 then return mx, my end
