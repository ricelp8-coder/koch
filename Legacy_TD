local LB = {
    claims = {}, claimNext = 0, questBusy = false,
    lead = nil, leadAt = 0, startAt = 0, startSent = 0,
    tpNext = 0, cooldown = {}, entered = nil, sumBusy = false, sumFails = 0, sumMoved = false, w = {},
}
local INV = {
    sellName = nil, sellLabels = {}, sellSig = "", refreshing = false, sold = nil,
    crateLabels = {}, crateSig = "", cratePend = nil, nextCrate = 0, noCrates = "No crates in inventory", w = {},
}
function LB.lifts()
    local f = workspace:FindFirstChild("Lifts")
    return f and f:GetChildren() or {}
end
function LB.wantMap()
    return MAP_BY_NAME[cfg.teleportMap] or MAPS[1]
end
function LB.areaOf(lift)
    local area = lift:FindFirstChild("Area")
    local base = lift:FindFirstChild("Base")
    if area and area:IsA("BasePart") then return area, base end
    if base and base:IsA("BasePart") then return base, base end
    return nil, nil
end
function LB.standPos(lift)
    local area, base = LB.areaOf(lift)
    if not area then return nil end
    if base and base:IsA("BasePart") then
        return Vector3.new(area.Position.X, base.Position.Y + base.Size.Y / 2 + 3, area.Position.Z)
    end
    return area.Position + Vector3.new(0, 3, 0)
end
function LB.occupied(lift)
    local area = LB.areaOf(lift)
    if not area then return false end
    local radius = math.max(6, math.max(area.Size.X, area.Size.Z) / 2 + 1)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then
            local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if hrp and math.abs(hrp.Position.Y - area.Position.Y) <= 14 and xzDist(hrp.Position, area.Position) <= radius then
                return true
            end
        end
    end
    return false
end
function LB.leave()
    local lead = LB.lead
    LB.lead, LB.entered = nil, nil
    local char = lp.Character
    local lift = lead and lead.lift
    local pos = lift and LB.standPos(lift)
    if char and pos then char:PivotTo(CFrame.new(pos + Vector3.new(26, 0, 0))) end
end
function LB.teleportStep()
    local net = FW.net()
    if not net then return 3 end
    local now = os.clock()
    local want, map = math.clamp(tonumber(cfg.teleportPlayers) or 1, 1, 4), LB.wantMap()
    local lead = LB.lead
    if lead and (not lead.lift.Parent or now - LB.leadAt > 90) then
        LB.lead, lead = nil, nil
    end
    if lead then
        if lead.map ~= map.id then
            LB.cooldown[lead.lift] = now + 10
            LB.leave()
            return 1
        end
        local need = math.min(want, tonumber(lead.max) or want)
        if (tonumber(lead.n) or 0) >= need and LB.startSent < 8 and now >= LB.startAt then
            FW.fire("StartTeleport", lead.lift)
            LB.startSent = LB.startSent + 1
            LB.startAt = now + 2
        end
        return 0.5
    end
    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return 1 end
    local best, bestD
    for _, lift in ipairs(LB.lifts()) do
        if lift.Name == map.id and now >= (LB.cooldown[lift] or 0) and not LB.occupied(lift) then
            local pos = LB.standPos(lift)
            if pos then
                local d = (pos - hrp.Position).Magnitude
                if not bestD or d < bestD then best, bestD = lift, d end
            end
        end
    end
    if not best then return 2 end
    local pos = LB.standPos(best)
    LB.entered = best
    LB.startSent = 0
    char:PivotTo(CFrame.new(pos))
    local t0, nudged = os.clock(), false
    while alive() and cfg.autoTeleport and os.clock() - t0 < 6 do
        if LB.lead and LB.lead.lift == best then return 0.3 end
        if not nudged and os.clock() - t0 > 1.5 then
            nudged = true
            char:PivotTo(CFrame.new(pos + Vector3.new(1.5, 0, 0)))
            task.wait(0.3)
            char:PivotTo(CFrame.new(pos))
        end
        task.wait(0.1)
    end
    if LB.lead and LB.lead.lift == best then return 0.3 end
    LB.cooldown[best] = os.clock() + 20
    LB.entered = nil
    return 1
end

function LB.stopSummon(why)
    if not (cfg.autoSummon1 or cfg.autoSummon10) then return end
    cfg.autoSummon1, cfg.autoSummon10 = false, false
    if LB.tg1 then LB.tg1:Set(false, true) end
    if LB.tg10 then LB.tg10:Set(false, true) end
    flash("Auto Summon stopped: " .. why, "Warning")
end
function LB.currencySig(data)
    local c = data and data.Currencies
    if type(c) ~= "table" then return "" end
    local keys = {}
    for k, v in pairs(c) do
        if type(v) == "number" then keys[#keys + 1] = k .. "=" .. v end
    end
    table.sort(keys)
    return table.concat(keys, ",")
end
function LB.gameSell()
    local sell = {Basic = false, Uncommon = false, Rare = false, Epic = false, Legendary = false}
    local frame = path(pg, "Lobby/SummonShopFrame/AutoSell")
    if frame then
        for rarity in pairs(sell) do
            local ok, text = pcall(function()
                local b = frame:FindFirstChild(rarity)
                b = b and b:FindFirstChild("OnAndOff")
                return b and b.Text
            end)
            if ok and text == "On" then sell[rarity] = true end
        end
    end
    return sell
end
function LB.summon(n)
    if LB.sumBusy then return end
    local mod = FW.get()
    local data = FW.data()
    if not (mod and data) or mod.SummoningTroop then return end
    local total, cap = INV.troopCount(data), tonumber(data.MaxAmountOfTroops)
    if cap and total + n > cap then
        LB.stopSummon("unit inventory is full (" .. total .. "/" .. cap .. ")")
        return
    end
    LB.sumBusy = true
    task.spawn(function()
        local before = LB.currencySig(data)
        FW.fire(n == 10 and "Summon10" or "Summon1", LB.gameSell())
        local t0 = os.clock()
        local changed = false
        while alive() and os.clock() - t0 < 6 do
            task.wait(0.2)
            if LB.currencySig(FW.data()) ~= before then changed = true break end
        end
        if changed then
            LB.sumFails, LB.sumMoved = 0, false
            local t1 = os.clock()
            while alive() and mod.SummoningTroop and os.clock() - t1 < 25 do task.wait(0.2) end
        else
            LB.sumFails = LB.sumFails + 1
            local zone = workspace:FindFirstChild("Zones")
            zone = zone and zone:FindFirstChild("SummonZone")
            local char = lp.Character
            if not LB.sumMoved and zone and char then
                LB.sumMoved = true
                char:PivotTo(CFrame.new(zone.Position + Vector3.new(0, 3, 0)))
                flash("Auto Summon: moved you into the Summon zone", "Info")
            elseif LB.sumFails >= 3 then
                LB.stopSummon("no effect (not enough currency?)")
                LB.sumFails = 0
            end
        end
        LB.sumBusy = false
    end)
end

function LB.claim(key, ...)
    local state = LB.claims[key]
    if type(state) == "number" and os.clock() < state then return false end
    if os.clock() < LB.claimNext then return false end
    LB.claims[key] = os.clock() + 25
    LB.claimNext = os.clock() + 0.8
    FW.fire(...)
    return true
end
function LB.claimQuests()
    if LB.questBusy or IN_MATCH or not cfg.autoClaimQuests then return end
    LB.questBusy = true
    local ok, err = pcall(function()
        local data = FW.data()
        local qd = FW.shared("QuestsData")
        local defs = qd and qd.Quests
        if not (data and type(data.Quests) == "table" and type(defs) == "table") then return end
        for _, kind in ipairs({"Daily", "Weekly"}) do
            local group = type(data.Quests[kind]) == "table" and data.Quests[kind].Quests
            if type(group) == "table" then
                local ids = {}
                for id in pairs(group) do ids[#ids + 1] = id end
                table.sort(ids)
                for _, id in ipairs(ids) do
                    local v, def = group[id], defs[id]
                    local req = type(def) == "table" and type(def.Requirements) == "table" and tonumber(def.Requirements[2])
                    if req and type(v) == "table" and (tonumber(v[1]) or 0) >= req and v[2] ~= true then
                        if LB.claim("Q/" .. kind .. "/" .. id, "ClaimQuestReward", kind, id) then return end
                    end
                end
            end
        end
    end)
    LB.questBusy = false
    if not ok then warn("[ld] claim: " .. tostring(err)) end
end

function INV.troopCount(data)
    local n = 0
    local t = data and data.Inventory and data.Inventory.Troops
    if type(t) == "table" then
        for _, group in pairs(t) do
            if type(group) == "table" then
                for _ in pairs(group) do n = n + 1 end
            end
        end
    end
    return n
end
function INV.display(name)
    local d = TW.def(name)
    return (d and d.DisplayName) or name
end
function INV.sellable(name, info, equipped, uid, sellData)
    if equipped[uid] or type(info) ~= "table" or info.ReallyLocked or info.SignedBy ~= nil then return false end
    local d = TW.def(name)
    local rarity = (d and d.Rarity) or "Basic"
    return sellData == nil or sellData[rarity] ~= nil
end
function INV.units()
    local data = FW.data()
    local counts, names = {}, {}
    local troops = data and data.Inventory and data.Inventory.Troops
    for name, group in pairs(type(troops) == "table" and troops or {}) do
        if type(group) == "table" then
            local n = 0
            for _ in pairs(group) do n = n + 1 end
            if n > 0 then
                names[#names + 1] = name
                counts[name] = n
            end
        end
    end
    table.sort(names)
    return names, counts, data ~= nil
end
function INV.sellPlan(name, mode)
    local data = FW.data()
    if type(name) ~= "string" or name == "" then return nil, "Select a unit first" end
    local group = data and data.Inventory and data.Inventory.Troops and data.Inventory.Troops[name]
    if type(group) ~= "table" then return nil, "Waiting for your inventory" end
    local equipped = {}
    for _, uid in pairs(type(data.EquippedTroopIds) == "table" and data.EquippedTroopIds or {}) do equipped[uid] = true end
    local sellData = FW.shared("TroopsSellData")
    local ids, total = {}, 0
    for uid, info in pairs(group) do
        total = total + 1
        if INV.sellable(name, info, equipped, uid, sellData) then ids[#ids + 1] = uid end
    end
    table.sort(ids)
    local want
    if mode == "All" then
        want = #ids
    elseif mode == "One" then
        want = math.min(#ids, 1)
    elseif mode == "KeepOne" then
        want = math.min(#ids, math.max(0, total - 1))
    else
        return nil, "Unknown sell mode"
    end
    while #ids > want do ids[#ids] = nil end
    return ids, nil, total
end
function INV.refreshSell(force)
    local names, counts, have = INV.units()
    local list, byLabel = {"(select a unit)"}, {}
    for _, n in ipairs(names) do
        local label = "(x" .. counts[n] .. ") " .. INV.display(n)
        list[#list + 1] = label
        byLabel[label] = n
    end
    INV.sellLabels = byLabel
    local label
    for l, n in pairs(byLabel) do
        if n == INV.sellName then label = l end
    end
    if INV.sellName and not label and have then INV.sellName = nil end
    local sig = table.concat(list, "\0")
    if INV.w.sellSel and (force or sig ~= INV.sellSig) then
        INV.sellSig = sig
        INV.refreshing = true
        pcall(function()
            INV.w.sellSel:SetOptions(list)
            INV.w.sellSel:Set(label or list[1], true)
        end)
        INV.refreshing = false
    end
    if INV.w.sellInfo then
        local text
        if not have then
            text = "Waiting for your inventory data..."
        elseif INV.sellName then
            local ids, _, total = INV.sellPlan(INV.sellName, "All")
            text = INV.display(INV.sellName) .. ": " .. tostring(total or 0) .. " copies, "
                .. tostring(ids and #ids or 0) .. " sellable (equipped, locked and signed are skipped)"
        else
            text = "Select a unit, then choose an action. Equipped, locked and signed copies are skipped."
        end
        INV.w.sellInfo:SetContent(text)
    end
end
function INV.exists(uid)
    local data = FW.data()
    local t = data and data.Inventory and data.Inventory.Troops
    if type(t) ~= "table" then return true end
    for _, group in pairs(t) do
        if type(group) == "table" and group[uid] ~= nil then return true end
    end
    return false
end
function INV.checkSale()
    local p = INV.sold
    if not p then return end
    if not FW.data() then return end
    for _, id in ipairs(p.ids) do
        if INV.exists(id) then
            if os.clock() - p.at > 20 and not p.warned then
                p.warned = true
                flash("Inventory: sale is not confirmed yet", "Warning")
            end
            if os.clock() - p.at > 45 then INV.sold = nil end
            return
        end
    end
    INV.sold = nil
    flash("Sold " .. #p.ids .. " " .. INV.display(p.name) .. " (confirmed)", "Success")
end
function INV.sell(mode)
    INV.checkSale()
    if INV.sold then
        flash("Inventory: waiting for the previous sale to confirm", "Warning")
        return
    end
    local ids, why = INV.sellPlan(INV.sellName, mode)
    if not ids or #ids == 0 then
        flash(why or "Inventory: no sellable copies for this action", "Warning")
        return
    end
    local sent = FW.fire("SellTroops", ids)
    if not sent then
        flash("Inventory: the sale did not go through (open the Units menu once and retry)", "Error")
        return
    end
    if type(sent) == "table" then ids = sent end
    INV.sold = {ids = ids, name = INV.sellName, at = os.clock()}
    flash("Selling " .. #ids .. " " .. INV.display(INV.sellName), "Info")
end

function INV.setCrate(text)
    if INV.w.crateInfo then INV.w.crateInfo:SetContent(text) end
end
function INV.crates()
    local data = FW.data()
    local cd = FW.shared("CrateDatas")
    local order, byName = {}, {}
    local crates = data and data.Inventory and data.Inventory.Crates
    for name, group in pairs(type(crates) == "table" and crates or {}) do
        if type(group) == "table" then
            local ids = {}
            for uid in pairs(group) do ids[#ids + 1] = uid end
            if #ids > 0 then
                table.sort(ids)
                local def = cd and cd[name]
                local e = {name = name, display = (type(def) == "table" and def.DisplayName) or name, ids = ids}
                byName[name] = e
                order[#order + 1] = e
            end
        end
    end
    table.sort(order, function(a, b) return a.display < b.display end)
    return order, byName, data ~= nil
end
function INV.refreshCrates(force)
    local sel = INV.w.crateSel
    if not sel then return end
    local order = INV.crates()
    local list, labels = {}, {}
    for _, e in ipairs(order) do
        local label = e.display .. " (x" .. #e.ids .. ")"
        list[#list + 1] = label
        labels[label] = e.name
    end
    if #list == 0 then list[1] = INV.noCrates end
    INV.crateLabels = labels
    local sig = table.concat(list, "\0")
    if force or sig ~= INV.crateSig then
        INV.crateSig = sig
        local chosen = list[1]
        for label, name in pairs(labels) do
            if name == cfg.openCrateName then chosen = label end
        end
        if labels[chosen] and cfg.openCrateName == nil then cfg.openCrateName = labels[chosen] end
        INV.refreshing = true
        pcall(function()
            sel:SetOptions(list)
            sel:Set(chosen, true)
        end)
        INV.refreshing = false
    end
end
function INV.crateStep()
    local now = os.clock()
    local _, byName, have = INV.crates()
    local e = byName[cfg.openCrateName]
    local p = INV.cratePend
    if p then
        local left = e and #e.ids or 0
        if left <= p.count - p.amount then
            INV.cratePend = nil
            INV.nextCrate = now + cfg.crateDelay
            INV.setCrate("Opened " .. p.amount .. " " .. p.display .. ", " .. left .. " left")
        elseif now - p.at >= 15 then
            INV.cratePend = nil
            INV.nextCrate = now + cfg.crateDelay
            INV.setCrate("Open was not confirmed in 15s, continuing")
        else
            return
        end
    end
    if now < INV.nextCrate then return end
    if not have then
        INV.setCrate("Waiting for your inventory")
        return
    end
    if not e or #e.ids == 0 then
        INV.setCrate("No crates of the selected type")
        return
    end
    local data = FW.data()
    local total, cap = INV.troopCount(data), tonumber(data and data.MaxAmountOfTroops)
    local amount = (cfg.openCrateAmount == 10 and #e.ids >= 10) and 10 or 1
    if cap and total + amount > cap then
        INV.setCrate("Unit inventory is full: " .. total .. "/" .. cap)
        return
    end
    INV.cratePend = {name = e.name, display = e.display, count = #e.ids, amount = amount, at = now}
    INV.nextCrate = now + math.max(1, cfg.crateDelay)
    FW.fire(amount == 10 and "Open10Crate" or "Open1Crate", e.ids[1])
    INV.setCrate("Opening " .. amount .. " " .. e.display .. ", waiting for confirmation")
end
function INV.loop()
    task.spawn(function()
        local n = 0
        while alive() do
            task.wait(1)
            n = n + 1
            pcall(INV.checkSale)
            if n % 2 == 0 then
                pcall(INV.refreshSell)
                pcall(INV.refreshCrates)
            end
            if cfg.autoOpenCrate or INV.cratePend then
                local ok, err = pcall(INV.crateStep)
                if not ok then INV.setCrate("Crate error: " .. tostring(err):sub(1, 100)) end
            end
        end
    end)
end

function LB.init()
    FW.load()
