mc.cb = {}
local TR = {}
function TR.live(e, m)
    return e ~= nil and e.gone == nil and m.Parent ~= nil
end
function TR.count()
    local n = 0
    for m, e in pairs(mc.reg) do
        if TR.live(e, m) then n = n + 1 end
    end
    return n
end
function TR.at(pos, name, skip)
    local best, bestD, bestE
    for m, e in pairs(mc.reg) do
        if TR.live(e, m) and not (skip and skip[m]) and (not name or e.name == name) then
            e.pos = TW.pos(m) or e.pos
            local d = xzDist(e.pos, pos)
            if d < 1.5 and math.abs(e.pos.Y - pos.Y) < 12 and (not bestD or d < bestD) then
                best, bestD, bestE = m, d, e
            end
        end
    end
    return best, bestE
end
function TR.add(m)
    if mc.reg[m] then
        mc.reg[m].away = nil
        return
    end
    local pos = TW.pos(m)
    if not pos then return end
    local e = {pos = pos, name = m.Name, at = os.clock()}
    mc.reg[m] = e
    local lv = m:FindFirstChild("TroopLevel")
    if lv then
        e.lv = tonumber(lv.Value) or 1
        lv.Changed:Connect(function()
            if not alive() then return end
            local old = e.lv or 1
            e.lv = tonumber(lv.Value) or old
            if e.lv > old and mc.cb.upgrade then pcall(mc.cb.upgrade, m, e, old) end
        end)
    end
    local tg = m:FindFirstChild("TroopTarget")
    if tg then
        tg.Changed:Connect(function()
            if alive() and mc.cb.target then pcall(mc.cb.target, m, e) end
        end)
    end
    m.AncestryChanged:Connect(function(_, parent)
        if parent == nil and alive() then TR.gone(m) end
    end)
    if mc.cb.place then pcall(mc.cb.place, m, e) end
end
-- a frozen or stunned unit is moved to FrozenTroops/StunnedTroops and back: only a destroyed unit counts as sold
function TR.gone(m)
    local e = mc.reg[m]
    if not e or e.gone then return end
    e.gone = os.clock()
    if alive() and mc.cb.sell then pcall(mc.cb.sell, m, e) end
    task.delay(2, function() if mc.reg[m] == e then mc.reg[m] = nil end end)
end
function TR.removed(m)
    local e = mc.reg[m]
    if not e or e.gone then return end
    task.delay(0.1, function()
        if mc.reg[m] ~= e or e.gone then return end
        if m.Parent ~= nil and m:IsDescendantOf(workspace) then
            e.away = true
            return
        end
        TR.gone(m)
    end)
end
function TR.consider(m)
    if not alive() or not m:IsA("Model") then return end
    local t0 = os.clock()
    while alive() and m.Parent do
        local o = m:FindFirstChild("TroopOwner")
        if o and o.Value ~= nil then
            if o.Value == lp then
                local last, same_ = nil, 0
                local t1 = os.clock()
                while alive() and m.Parent and os.clock() - t1 < 1.5 and same_ < 3 do
                    local p = TW.pos(m)
                    if p and last and (p - last).Magnitude < 0.01 then same_ = same_ + 1 else same_ = 0 end
                    last = p
                    task.wait(0.05)
                end
                if m.Parent then TR.add(m) end
            end
            return
        end
        if os.clock() - t0 > 5 then return end
        task.wait(0.1)
    end
end
function TR.connect()
    local f = TW.folder() or workspace:WaitForChild("Troops", 30)
    if not f then return false end
    f.ChildAdded:Connect(function(m) task.spawn(TR.consider, m) end)
    f.ChildRemoved:Connect(function(m) TR.removed(m) end)
    for _, m in ipairs(f:GetChildren()) do task.spawn(TR.consider, m) end
    return true
end

local MT = {}
function MT.liveSellWave()
    local txt = sellFarmInput and sellFarmInput:Get()
    if txt ~= nil then
        local w = parseWave(txt)
        cfg.sellFarmWave = (w >= 1) and w or nil
    end
    return cfg.sellFarmWave
end
function MT.sellFarms(myMatch, wave)
    task.spawn(function()
        local list = {}
        for m, e in pairs(mc.reg) do
            if TR.live(e, m) and TW.isFarm(e.name) then list[#list + 1] = m end
        end
        local total = #list
        if total == 0 then return end
        local function standing()
            local n = 0
            for _, m in ipairs(list) do
                if m.Parent and TR.live(mc.reg[m], m) then n = n + 1 end
            end
            return n
        end
        for _ = 1, 4 do
            for _, m in ipairs(list) do
                if m.Parent and TR.live(mc.reg[m], m) then
                    FW.fire("SellTroop", m)
                    task.wait(math.max(0.1, tonumber(cfg.sellFarmDelay) or 0.1))
                end
            end
            task.wait(0.6)
            if not alive() or mc.matchId ~= myMatch then return end
            if standing() == 0 then break end
        end
        local left = standing()
        flash(string.format("Auto Sell Farms: sold %d/%d on wave %d", total - left, total, wave),
            left == 0 and "Success" or "Warning")
    end)
end
function MT.checkFarmSell()
    local w = MT.liveSellWave()
    if not cfg.autoSellFarm or not w or w <= 0 or mc.wave < w then return end
    if st.farmSoldMatch == mc.matchId then return end
    st.farmSoldMatch = mc.matchId
    MT.sellFarms(mc.matchId, mc.wave)
end
function MT.clearStamps()
    mc.stamps = {Place = {}, Upgrade = {}, Sell = {}, Target = {}}
end
function MT.newMatch()
    if mc.rec and finishRecording then finishRecording("New match") end
    mc.matchId = mc.matchId + 1
    mc.wave = 0
    MT.clearStamps()
    mc.claim, mc.k2pos, mc.spend, mc.nextAt = {}, {}, nil, 0
    mc.finalSeen = false
    st.farmSoldMatch, st.waveStart, st.matchStart, st.matchMode = nil, nil, nil, nil
    st.skipKey, st.skipTries, st.skipSeen, st.skipHold, st.voteTries = nil, 0, false, nil, 0
    if MT.endReset then MT.endReset() end
    if mc.rec then
        mc.rec = false
        if recToggle then recToggle:Set(false, true) end
        flash("Recording stopped: new match")
    end
end
function MT.waveChanged(n)
    n = tonumber(n) or 0
    if n <= 0 then
        -- a wave counter that drops to 0 mid-round is not a new match; the next round is caught by finalSeen
        if mc.wave > 0 and not mc.finalSeen then warn("[ld] wave counter went to 0 on wave " .. mc.wave) end
        return
    end
    if n < mc.wave and not mc.finalSeen then
        warn("[ld] new match: wave " .. mc.wave .. " -> " .. n)
        MT.newMatch()
    elseif n <= 1 and mc.finalSeen then
        MT.newMatch()
    end
    mc.wave = n
    st.waveStart = os.clock()
    if n == 1 or not st.matchStart then st.matchStart = os.clock() end
    MT.checkFarmSell()
end
function MT.waveTime()
    return st.waveStart and (os.clock() - st.waveStart) or nil
end
function MT.skipAvailable()
    return MD.val("CanSkip", false) == true
end
function MT.skipVoted()
    local v = MD.obj("VoteSkipPlayers")
    return v ~= nil and v:FindFirstChild(tostring(lp.UserId)) ~= nil
end
function MT.fireSkip()
    return FW.fire("VoteSkipWave")
end
function MT.skipGap(wave)
    return wave == 0 and 0.6 or 1.2
end
function MT.trySkip()
    if not cfg.autoSkip or mc.finalSeen then return end
    if not MT.skipAvailable() then
        st.skipKey, st.skipTries, st.skipSeen, st.skipHold = nil, 0, false, nil
        return
    end
    if MD.voting() then return end
    local w = MD.wave()
    local now = os.clock()
    local key = mc.matchId .. ":" .. w
    if st.skipKey ~= key then
        st.skipKey, st.skipTries, st.skipAt, st.skipReady, st.skipSeen, st.skipHold = key, 0, 0, now, false, nil
    end
    if MT.skipVoted() then
        st.skipSeen = true
        return
    end
    if st.skipSeen then
        st.skipSeen, st.skipTries, st.skipAt, st.skipReady = false, 0, 0, now
        st.skipHold = now + 0.4
    end
    if st.skipHold and now < st.skipHold then return end
    if isBarrier(w) then
        if st.skipWarnMatch ~= mc.matchId or st.skipWarnWave ~= w then
            st.skipWarnMatch, st.skipWarnWave = mc.matchId, w
            flash("Auto Skip paused: barrier on wave " .. w, "Warning")
        end
        return
    end
    if st.skipTries >= 5 or now - st.skipAt < MT.skipGap(w) then return end
    if now - st.skipReady < (tonumber(cfg.skipDelay) or 0) then return end
    if not FW.net() then return end
    st.skipTries = st.skipTries + 1
    st.skipAt = now
    MT.fireSkip()
end
function MT.myVote()
    local vf = RS:FindFirstChild("VotingFolder")
    local pl = vf and vf:FindFirstChild("Players")
