    local old
    local ok, err = pcall(function()
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local sink = genv.__ldNet
            if sink and sink.on and rawequal(self, sink.r) and not (checkcaller and checkcaller()) then
