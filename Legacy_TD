                LB.leadAt = os.clock()
                if newLift then LB.startSent, LB.startAt = 0, 0 end
            elseif LB.lead and LB.lead.lift == lift then
                LB.lead = nil
            end
        end)
    end)
    task.spawn(function()
        while alive() and not FW.data() do task.wait(1) end
    end)
