local function initMatch()
    while alive() and not (MD.folder() and workspace:FindFirstChild("Troops")) do task.wait(1) end
    if not alive() then return end
    FW.load()
    local net
    local t0 = os.clock()
    while alive() and not net and os.clock() - t0 < 60 do
        net = FW.net()
        if not net then task.wait(0.5) end
    end
    mc.ok = net ~= nil and type(net.Fire) == "function"
    mc.hook = mc.ok
    if not mc.ok then flash("Macro disabled: game network not found", "Error") end
    mc.initDone = true
    if not mc.ok and mc.play then
        mc.play = false
        syncToggles()
    end
    if not TR.connect() then warn("[ld] workspace.Troops not found") end
    local waveObj = MD.obj("CurrentWave")
    if waveObj then
        local n = MD.wave()
        if n > 0 then
            mc.wave = n
            st.waveStart, st.matchStart = os.clock(), os.clock()
        end
        waveObj.Changed:Connect(function(v)
            if alive() then pcall(MT.waveChanged, v) end
        end)
    end
    if net then
        pcall(function()
            net.Fired("ShowMatchFinishStat"):Connect(function(map, _, coins, candy, _, _, won, mode)
                if alive() then
                    pcall(MT.ended, {map = map, coins = tonumber(coins), candy = tonumber(candy), won = won == true, mode = mode})
                end
            end)
        end)
    end
    task.spawn(function()
        while alive() do
            task.wait(0.1)
            local ok1, e1 = pcall(playbackTick)
            if not ok1 then warn("[ld] playback: " .. tostring(e1)) end
            pcall(MT.voteStep)
            local open = MT.finishOpen()
            if not mc.finalSeen and open then pcall(MT.ended, nil) end
            if mc.finalSeen and open then st.finishSeenOpen, st.finishClosedAt = true, nil end
            if mc.finalSeen and st.finishSeenOpen and not open then
                st.finishClosedAt = st.finishClosedAt or os.clock()
                if os.clock() - st.finishClosedAt > 2 then
                    -- the finish screen stayed closed in this server: the next round is starting
                    st.finishSeenOpen, st.finishClosedAt = false, nil
                    pcall(MT.newMatch)
                end
            end
            if mc.finalSeen then
                st.finalShown = true
                if cfg.endAction ~= "None" then
                    local ok, err = pcall(END.step, cfg.endAction)
                    if not ok then warn("[ld] endAction: " .. tostring(err)) end
                end
            elseif END.active then
                END.reset()
            end
        end
    end)
    task.spawn(function()
        while alive() do
            task.wait(2)
            pcall(MT.checkFarmSell)
        end
    end)
    task.spawn(function()
        while alive() do
            task.wait(0.05)
            if cfg.autoSkip then pcall(MT.trySkip) end
        end
    end)
    for _, name in ipairs({"CanSkip", "CurrentWave", "Interval", "Voting"}) do
        local o = MD.obj(name)
        if o then
            o.Changed:Connect(function()
                if alive() and cfg.autoSkip then pcall(MT.trySkip) end
            end)
        end
    end
    local votes = MD.obj("VoteSkipPlayers")
    if votes then
        votes.ChildAdded:Connect(function(c)
            if alive() and c.Name == tostring(lp.UserId) and mc.cb.skip then pcall(mc.cb.skip) end
        end)
        votes.ChildRemoved:Connect(function()
            if alive() and cfg.autoSkip then pcall(MT.trySkip) end
        end)
    end
end
