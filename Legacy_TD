function GU.placeNow(name, pos)
    local i = GU.slotOf(name)
    local btn = i and path(pg, "MainFrames/TroopsSelector/Troops/Troop" .. i .. "/InteractiveButton")
    if not btn then return false, "not in hotbar" end
    local fw = FW.get()
    local pl = fw and fw.Placement
    local cam = workspace.CurrentCamera
    local saveType, saveCf = cam.CameraType, cam.CFrame
    -- the spot is held at the screen centre: on phones the injected mouse and the viewport differ in scale,
    -- and the centre is the one point where both agree
    local hold = CFrame.lookAt(pos + Vector3.new(0, 40, 0.05), pos)
    local RunS = game:GetService("RunService")
    local bound = pcall(function()
        RunS:BindToRenderStep("ld_place_cam", Enum.RenderPriority.Camera.Value + 10, function()
            cam.CameraType = Enum.CameraType.Scriptable
            cam.CFrame = hold
        end)
    end)
    local hidden = GU.ownGuis(false)
    local started, ended, placed = false, false, false
    local conns = {}
    if pl and pl.PlacementStarted then
        pcall(function() conns[#conns + 1] = pl.PlacementStarted:Connect(function() started = true end) end)
    end
    if pl and pl.PlacementEnded then
        pcall(function() conns[#conns + 1] = pl.PlacementEnded:Connect(function() ended = true end) end)
    end
    local tf = TW.folder()
    if tf then
        conns[#conns + 1] = tf.ChildAdded:Connect(function(m)
            if m.Name == name then placed = true end
        end)
    end
    local ok, err = pcall(function()
        cam.CameraType = Enum.CameraType.Scriptable
        cam.CFrame = hold
        task.wait()
        task.wait()
        GU.inputSnap = GU.snapInput()
        if not GU.press(btn) then error("slot press failed", 0) end
        local t0 = os.clock()
        while not started and os.clock() - t0 < 0.6 do task.wait() end
        local sp = cam:WorldToViewportPoint(pos)
        if not GU.mouseTo(sp.X, sp.Y) then error("no mouse input in this executor", 0) end
        task.wait(0.06)
        sp = cam:WorldToViewportPoint(pos)
        local mx, my = GU.mouseTo(sp.X, sp.Y)
        if not mx then error("no mouse input in this executor", 0) end
        local v = GU.vim()
        local ways = {
            click = function()
                v:SendMouseButtonEvent(mx, my, 0, true, game, 0)
                task.wait()
                v:SendMouseButtonEvent(mx, my, 0, false, game, 0)
            end,
            touch = function()
                local cx, cy = sp.X, sp.Y
                v:SendTouchEvent(7, 0, cx, cy)
                task.wait(0.03)
                v:SendTouchEvent(7, 1, cx, cy)
                task.wait(0.05)
                v:SendTouchEvent(7, 2, cx, cy)
            end,
            touch2 = function()
                v:SendTouchEvent(8, 0, mx, my)
                task.wait(0.03)
                v:SendTouchEvent(8, 1, mx, my)
                task.wait(0.05)
                v:SendTouchEvent(8, 2, mx, my)
            end,
            hold = function()
                v:SendMouseButtonEvent(mx, my, 0, true, game, 0)
                task.wait(0.15)
                v:SendMouseButtonEvent(mx, my, 0, false, game, 0)
            end,
            -- the injected tap never reaches the placement module on some phones: hand its own input handlers a
            -- left click at the aimed point (the aim itself is already exact)
            signal = function()
                local n = GU.feedPlacementInput(function() return placed or ended end)
                if n == 0 then error("no placement input handlers found", 0) end
            end,
        }
        local order = {"click", "signal", "touch", "touch2", "hold"}
        if GU.confirmWay then table.insert(order, 1, GU.confirmWay) end
        local used, tried = nil, {}
        for _, way in ipairs(order) do
            if not tried[way] and v then
                tried[way] = true
                local okW, errW = pcall(ways[way])
                if okW then
                    local t1 = os.clock()
                    while not (placed or ended) and os.clock() - t1 < 0.5 do task.wait() end
                    if placed or ended then
                        used = way
                        break
                    end
                else
                    warn("[ld] place via " .. way .. " failed: " .. tostring(errW))
                end
            end
        end
        if not v and type(mouse1click) == "function" then pcall(mouse1click) end
        if used then GU.confirmWay = used end
        if not GU.dumped and pl then
            GU.dumped = true
            local keys = {}
            pcall(function()
                for k, val in pairs(pl) do keys[#keys + 1] = tostring(k) .. ":" .. typeof(val) end
                local mt = getmetatable(pl)
                if type(mt) == "table" and type(mt.__index) == "table" then
                    for k, val in pairs(mt.__index) do keys[#keys + 1] = "mt." .. tostring(k) .. ":" .. typeof(val) end
                end
            end)
            table.sort(keys)
            warn("[ld] placement api: " .. table.concat(keys, ", "))
            local vs = cam.ViewportSize
            local ms = lp:GetMouse()
            warn(string.format("[ld] screen: viewport %.0fx%.0f | mouse location %s | mouse xy %d,%d | touch=%s mouse=%s",
                vs.X, vs.Y, tostring(UIS:GetMouseLocation()), ms.X, ms.Y, tostring(UIS.TouchEnabled), tostring(UIS.MouseEnabled)))
        end
        local dg = GU.diag
        local hit = lp:GetMouse().Hit.Position
        local function v2(v) return v and string.format("%.0f,%.0f", v.X, v.Y) or "-" end
        warn(string.format("[ld] place %s: screen %.0f,%.0f | engine %s / %s / %s | mouse hit %.1f,%.1f want %.1f,%.1f | started=%s confirmed=%s",
            tostring(name), sp.X, sp.Y, v2(dg and dg.l1), v2(dg and dg.l2), v2(dg and dg.l3),
            hit.X, hit.Z, pos.X, pos.Z, tostring(started), tostring(used or "none")))
    end)
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    if bound then pcall(function() RunS:UnbindFromRenderStep("ld_place_cam") end) end
    pcall(function()
        cam.CameraType = saveType
        cam.CFrame = saveCf
    end)
    GU.ownGuis(true, hidden)
    return ok, err
end
-- true when f was created by the game's MultiboxFramework (or another game script), not by the engine or the executor
function GU.gameFn(f)
    if type(f) ~= "function" then return false end
    local src
    pcall(function() src = debug.info(f, "s") end)
    if type(src) == "string" and src:find("MultiboxFramework", 1, true) then return true end
    local ok, env = pcall(getfenv, f)
    local sc = ok and type(env) == "table" and rawget(env, "script")
    if typeof(sc) == "Instance" then
        local fwm = RS:FindFirstChild("MultiboxFramework")
        return fwm ~= nil and (sc == fwm or sc:IsDescendantOf(fwm))
    end
    return false
end
function GU.inputSignals()
    local ms = lp:GetMouse()
    return {
        InputBegan = UIS.InputBegan, InputEnded = UIS.InputEnded, TouchEnded = UIS.TouchEnded,
        TouchTapInWorld = UIS.TouchTapInWorld, Button1Down = ms.Button1Down, Button1Up = ms.Button1Up,
    }
end
function GU.snapInput()
    local snap = {}
    if type(getconnections) ~= "function" then return snap end
    for name, sig in pairs(GU.inputSignals()) do
        local set = {}
        local ok, cs = pcall(getconnections, sig)
        if ok and type(cs) == "table" then
            for _, c in ipairs(cs) do
                local okf, f = pcall(function() return c.Function end)
                if okf and type(f) == "function" then set[f] = true end
            end
        end
        snap[name] = set
    end
    return snap
end
function GU.feedPlacementInput(done)
    if type(getconnections) ~= "function" then error("no getconnections in this executor", 0) end
    local ms = lp:GetMouse()
    local at = Vector3.new(ms.X, ms.Y, 0)
    local function fake(kind, state)
        return {UserInputType = kind, UserInputState = state, KeyCode = Enum.KeyCode.Unknown, Position = at, Delta = Vector3.zero}
    end
    local plan = {
        {"InputBegan", function() return fake(Enum.UserInputType.MouseButton1, Enum.UserInputState.Begin), false end},
        {"InputEnded", function() return fake(Enum.UserInputType.MouseButton1, Enum.UserInputState.End), false end},
        {"Button1Down", function() end},
        {"Button1Up", function() end},
        {"InputBegan", function() return fake(Enum.UserInputType.Touch, Enum.UserInputState.Begin), false end},
        {"InputEnded", function() return fake(Enum.UserInputType.Touch, Enum.UserInputState.End), false end},
        {"TouchTapInWorld", function() return Vector2.new(at.X, at.Y), false end},
        {"TouchEnded", function() return fake(Enum.UserInputType.Touch, Enum.UserInputState.End), false end},
    }
    local sigs = GU.inputSignals()
    local snap = GU.inputSnap or {}
    local fired, report = 0, {}
    for i, step in ipairs(plan) do
        local ok, cs = pcall(getconnections, sigs[step[1]])
        local before = snap[step[1]]
        local total, mine = 0, 0
        if ok and type(cs) == "table" then
            total = #cs
            for _, c in ipairs(cs) do
                local okf, f = pcall(function() return c.Function end)
                -- a handler connected by the slot press (the placement module connects on Start), or one the
                -- framework owns
                local fresh = okf and type(f) == "function" and before ~= nil and not before[f]
                if okf and (fresh or GU.gameFn(f)) then
                    mine = mine + 1
                    fired = fired + 1
                    task.spawn(function() pcall(f, step[2]()) end)
                end
            end
        end
        report[#report + 1] = i .. ":" .. mine .. "/" .. total
        if mine > 0 then
            local t0 = os.clock()
            while not done() and os.clock() - t0 < 0.35 do task.wait() end
            if done() then break end
        end
    end
    warn("[ld] placement handlers (signal:game/all): " .. table.concat(report, " "))
    return fired
end
function GU.stopPlacing()
    local fw = FW.get()
    local pl = fw and fw.Placement
    if pl and type(pl.Stop) == "function" then pcall(pl.Stop) end
