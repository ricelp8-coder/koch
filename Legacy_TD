            return os.clock() >= mc.nextAt
        end, math.huge, myMatch, 0.05)
        if not ready then return false end
        if there then
            local m2, e2 = TR.at(p, s.n, mc.claim)
            if m2 then
                mc.claim[m2] = true
                if s.k then mc.k2pos[s.k] = e2.pos end
                return true, m2
            end
        end
        local before = money()
        local calledAt = os.clock()
        local sent, why
        NET.viaNet = false
        if cfg.netPlace ~= false then
            -- no tap fallback here: the tapping path crashes the game on phones
            if not NET.way and NET.fails >= #NET.variants then
