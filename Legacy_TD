        if money() < price then
            moneyFails = moneyFails + 1
            if not sleep(0.35 + 0.15 * math.min(moneyFails, 8), myMatch) then return false end
        else
            attempts = attempts + 1
            if attempts >= 5 then
                flash(tostring(s.n) .. ": place rejected, step skipped", "Warning")
