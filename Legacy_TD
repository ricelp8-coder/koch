function MT.voteStep()
    if not (cfg.autoVote and MD.voting()) then return end
    if MT.myVote() == cfg.mode then return end
    local now = os.clock()
    if st.voteTries >= 4 or now - st.voteLast < 1.5 then return end
    st.voteTries = st.voteTries + 1
    st.voteLast = now
    st.matchMode = cfg.mode
    FW.fire("VoteMap", cfg.mode)
end

