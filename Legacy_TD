    if not l1 then return nil end
    GU.diag = {x = x, y = y, l1 = l1}
    if math.abs(l1.X - x) <= 1.5 and math.abs(l1.Y - y) <= 1.5 then return x, y end
    local d = 40
    local l2 = GU.readMouse(x + d, y + d)
    if not l2 then return x, y end
    local gx, gy = (l2.X - l1.X) / d, (l2.Y - l1.Y) / d
    GU.diag.l2, GU.diag.gx, GU.diag.gy = l2, gx, gy
